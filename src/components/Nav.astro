---
const links = [
  { href: "/#features", label: "Features" },
  { href: "/#download", label: "Download" },
  { href: "/changelog", label: "Changelog" },
  { href: "/privacy", label: "Privacy" },
];
---
<nav class="border-b border-[var(--color-border)] sticky top-0 backdrop-blur-md bg-[color-mix(in_oklab,var(--color-bg)_85%,transparent)] z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-semibold text-lg tracking-tight flex items-center gap-2">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="2" />
        <path d="M7 12h10M12 7v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      ViewBus
    </a>
    <ul class="flex items-center gap-6 text-sm text-[var(--color-muted)]">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-[var(--color-fg)] transition-colors">{label}</a></li>
      ))}
      <li>
        <a href="https://github.com/haakofli/viewbus-site" aria-label="GitHub" class="hover:text-[var(--color-fg)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</nav>
