---
import LogoMark from "./LogoMark.astro";
import Wordmark from "./Wordmark.astro";

export interface Props {
  path?: string;
}
const { path = "/" } = Astro.props;

const links = [
  { href: "/#features", label: "Features" },
  { href: "/why-viewbus/", label: "Why viewbus" },
  { href: "/developers/", label: "Developers" },
  { href: "/changelog/", label: "Changelog" },
];
const coffeeUrl = "https://buymeacoffee.com/hakonlia";

const isActive = (href: string) => href.startsWith("/") && !href.includes("#") && path === href;
---
<nav
  id="site-nav"
  class="lifted sticky top-0 z-50 border-b border-transparent backdrop-blur-xl backdrop-saturate-150 bg-[color-mix(in_oklab,var(--color-bg)_88%,transparent)] transition-colors"
>
  <div class="max-w-6xl mx-auto px-6 h-14 grid grid-cols-[auto_1fr_auto] items-center gap-6">
    <a href="/" class="flex items-center gap-2 text-[var(--color-fg)]" aria-label="viewbus home">
      <LogoMark variant="color" width={22} height={18} />
      <Wordmark size="sm" />
    </a>

    <ul class="hidden lg:flex items-center justify-center gap-7 text-sm text-[var(--color-muted)]">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="whitespace-nowrap transition-colors hover:text-[var(--color-fg)] aria-[current=page]:text-[var(--color-fg)] aria-[current=page]:font-medium"
          >{label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center justify-end gap-1.5">
      <button
        type="button"
        data-theme-toggle
        aria-label="Switch theme"
        class="inline-flex items-center justify-center size-9 rounded-md text-[var(--color-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-hover)] cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
      >
        <svg data-theme-sun class="hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-theme-moon width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <a
        href={coffeeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 h-8 px-3 rounded-full text-[var(--color-muted)] hover:text-[var(--color-fg)] text-xs font-medium border border-[var(--color-border)] hover:border-[color-mix(in_oklab,var(--color-fg)_25%,transparent)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
          <line x1="6" y1="2" x2="6" y2="4" />
          <line x1="10" y1="2" x2="10" y2="4" />
          <line x1="14" y1="2" x2="14" y2="4" />
        </svg>
        <span>Buy me a coffee</span>
      </a>

      <a
        href="/download/"
        data-desktop-only
        class="hidden sm:inline-flex items-center gap-1.5 h-8 px-3.5 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] text-xs font-medium hover:bg-[color-mix(in_oklab,var(--color-fg)_88%,transparent)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12" /><path d="m7 12 5 5 5-5" /><path d="M4 21h16" />
        </svg>
        <span>Download</span>
      </a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        id="nav-toggle"
        aria-label="Open menu"
        aria-controls="nav-mobile"
        aria-expanded="false"
        class="lg:hidden inline-flex items-center justify-center size-11 -mr-2.5 rounded-md text-[var(--color-fg)] hover:bg-[var(--color-hover)] cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
      >
        <svg data-nav-open width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg data-nav-close class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="nav-mobile" class="lg:hidden hidden relative z-10 border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <ul class="flex flex-col px-6 py-2">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            data-nav-link
            aria-current={isActive(href) ? "page" : undefined}
            class="flex min-h-11 items-center text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)] aria-[current=page]:text-[var(--color-fg)] aria-[current=page]:font-medium"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/mcp-server/"
          data-nav-link
          class="flex min-h-11 items-center text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
        >MCP server</a>
      </li>
      <li>
        <a
          href="/support/"
          data-nav-link
          class="flex min-h-11 items-center text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)]"
        >Support</a>
      </li>
      <li class="flex flex-wrap items-center gap-2 py-3">
        <a
          href="/download/"
          data-nav-link
          data-desktop-only
          class="inline-flex items-center gap-1.5 h-11 px-4 rounded-full bg-[var(--color-fg)] text-[var(--color-bg)] text-sm font-medium"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" /><path d="m7 12 5 5 5-5" /><path d="M4 21h16" />
          </svg>
          <span>Download</span>
        </a>
        <a
          href={coffeeUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-nav-link
          class="inline-flex items-center gap-1.5 h-11 px-4 rounded-full text-[var(--color-fg)] text-sm font-medium border border-[var(--color-border)] hover:border-[color-mix(in_oklab,var(--color-fg)_25%,transparent)] transition-colors"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <line x1="6" y1="2" x2="6" y2="4" />
            <line x1="10" y1="2" x2="10" y2="4" />
            <line x1="14" y1="2" x2="14" y2="4" />
          </svg>
          <span>Buy me a coffee</span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Scrim behind the open drawer -->
  <div data-nav-scrim class="hidden lg:hidden fixed inset-0 top-14 z-0 bg-black/40" aria-hidden="true"></div>

  <script is:inline>
    (() => {
      const nav = document.getElementById("site-nav");
      const btn = document.getElementById("nav-toggle");
      const panel = document.getElementById("nav-mobile");
      const scrim = nav && nav.querySelector("[data-nav-scrim]");
      if (!btn || !panel || !nav) return;
      const openIcon = btn.querySelector("[data-nav-open]");
      const closeIcon = btn.querySelector("[data-nav-close]");
      const setOpen = (open) => {
        panel.classList.toggle("hidden", !open);
        if (scrim) scrim.classList.toggle("hidden", !open);
        // The bar itself must go opaque while the drawer is open, otherwise
        // page content shows through the header row above the panel.
        nav.classList.toggle("nav-open", open);
        document.documentElement.classList.toggle("nav-locked", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        openIcon && openIcon.classList.toggle("hidden", open);
        closeIcon && closeIcon.classList.toggle("hidden", !open);
      };
      btn.addEventListener("click", () => setOpen(panel.classList.contains("hidden")));
      panel.querySelectorAll("[data-nav-link]").forEach((a) =>
        a.addEventListener("click", () => setOpen(false)),
      );
      scrim && scrim.addEventListener("click", () => setOpen(false));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
      // Collapse if the viewport grows into the desktop layout.
      const mq = window.matchMedia("(min-width: 1024px)");
      mq.addEventListener("change", (e) => {
        if (e.matches) setOpen(false);
      });

      // Hairline under the bar once the page has scrolled beneath it.
      const onScroll = () => nav.classList.toggle("is-stuck", window.scrollY > 4);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>

  <script is:inline>
    // Theme follows the OS until the visitor overrides it here; the override
    // then sticks. Base.astro applies the same rule before first paint.
    (() => {
      const KEY = "viewbus-site-theme";
      const root = document.documentElement;
      const system = window.matchMedia("(prefers-color-scheme: dark)");

      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };

      const sync = () => {
        const dark = !root.classList.contains("light");
        document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
          btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
          const sun = btn.querySelector("[data-theme-sun]");
          const moon = btn.querySelector("[data-theme-moon]");
          sun && sun.classList.toggle("hidden", !dark);
          moon && moon.classList.toggle("hidden", dark);
        });
      };

      document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const goingDark = root.classList.contains("light");
          root.classList.toggle("light", !goingDark);
          try {
            // Choosing the theme the OS already asks for goes back to
            // following the OS, rather than pinning it forever.
            if (system.matches === goingDark) localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, goingDark ? "dark" : "light");
          } catch {}
          sync();
        });
      });

      system.addEventListener("change", (e) => {
        if (read()) return; // an explicit choice wins over the OS
        root.classList.toggle("light", !e.matches);
        sync();
      });

      sync();
    })();
  </script>
</nav>
