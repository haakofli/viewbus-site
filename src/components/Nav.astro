---
import LogoMark from "./LogoMark.astro";
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/changelog", label: "Changelog" },
  { href: "/privacy", label: "Privacy" },
];
---
<nav class="lifted sticky top-0 z-50 backdrop-blur-xl backdrop-saturate-150 bg-[color-mix(in_oklab,var(--color-bg)_65%,transparent)]">
  <div class="max-w-6xl mx-auto px-6 h-14 grid grid-cols-[auto_1fr_auto] items-center gap-6">
    <a href="/" class="flex items-center gap-2 text-[var(--color-fg)]" aria-label="viewbus home">
      <LogoMark variant="color" width={22} height={18} />
      <Wordmark size="sm" />
    </a>

    <ul class="hidden md:flex items-center justify-center gap-7 text-sm text-[var(--color-muted)]">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-[var(--color-fg)] transition-colors">{label}</a></li>
      ))}
    </ul>

    <div class="flex items-center justify-end gap-2">
      <a
        href="https://buymeacoffee.com/hakonlia"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full text-[var(--color-muted)] hover:text-[var(--color-fg)] text-xs font-medium border border-[var(--color-border)] hover:border-[color-mix(in_oklab,var(--color-fg)_25%,transparent)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
          <line x1="6" y1="2" x2="6" y2="4" />
          <line x1="10" y1="2" x2="10" y2="4" />
          <line x1="14" y1="2" x2="14" y2="4" />
        </svg>
        <span>Buy me a coffee</span>
      </a>
    </div>
  </div>

  <ul class="md:hidden flex items-center justify-center gap-5 px-6 pb-2 text-sm text-[var(--color-muted)]">
    {links.map(({ href, label }) => (
      <li><a href={href} class="hover:text-[var(--color-fg)] transition-colors">{label}</a></li>
    ))}
  </ul>
</nav>
