---
import LogoMark from "./LogoMark.astro";
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/changelog", label: "Changelog" },
  { href: "/privacy", label: "Privacy" },
];
---
<nav class="sticky top-0 z-50 border-b border-[var(--color-border)] backdrop-blur-md bg-[color-mix(in_oklab,var(--color-bg)_85%,transparent)]">
  <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-[var(--color-fg)]" aria-label="viewbus home">
      <LogoMark variant="color" width={22} height={18} />
      <Wordmark size="sm" />
    </a>
    <ul class="flex items-center gap-6 text-sm text-[var(--color-muted)]">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-[var(--color-fg)] transition-colors">{label}</a></li>
      ))}
    </ul>
  </div>
</nav>
