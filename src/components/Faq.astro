---
export interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;

// Answers double as the JSON-LD text, so they stay plain strings. Backticks are
// the one bit of markup allowed, for inline commands and paths.
const segments = (answer: string) =>
  answer.split(/`([^`]+)`/g).map((part, i) => ({ text: part, code: i % 2 === 1 }));
---
<div class:list={["faq", className]}>
  {items.map((item) => (
    <details class="faq-item">
      <summary class="faq-q">
        <span>{item.q}</span>
        <svg class="faq-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="faq-a">
        <p>{segments(item.a).map((s) => (s.code ? <code class="ic">{s.text}</code> : s.text))}</p>
      </div>
    </details>
  ))}
</div>

<script>
  // <details> won't animate on its own in every engine, so drive the open and
  // close with the Web Animations API and let `open` follow the animation.
  document.querySelectorAll<HTMLElement>(".faq").forEach((group) => {
    group.classList.add("faq-js");

    group.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((item) => {
      const summary = item.querySelector<HTMLElement>(".faq-q");
      const body = item.querySelector<HTMLElement>(".faq-a");
      if (!summary || !body) return;

      let running: Animation | null = null;
      item.classList.toggle("is-open", item.open);

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        running?.cancel();

        const closing = item.open;
        if (!closing) item.open = true;
        item.classList.toggle("is-open", !closing);

        // Reduced motion still gets a short cue rather than nothing — an
        // accordion isn't the kind of movement that setting is guarding against.
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const height = `${body.offsetHeight}px`;
        const from = closing ? { height, opacity: 1 } : { height: "0px", opacity: 0 };
        const to = closing ? { height: "0px", opacity: 0 } : { height, opacity: 1 };

        running = body.animate([from, to], {
          duration: reduced ? 120 : 280,
          easing: "cubic-bezier(0.32, 0.72, 0, 1)",
        });
        running.onfinish = () => {
          running = null;
          if (closing) item.open = false;
        };
        running.oncancel = () => { running = null; };
      });
    });
  });
</script>

<style is:global>
  .faq { border-top: 1px solid var(--color-border); }
  .faq-item { border-bottom: 1px solid var(--color-border); }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.5rem;
    padding: 0.9rem 0;
    font-weight: 600;
    line-height: 1.45;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::marker { content: ""; }
  .faq-q:hover { color: var(--color-accent); }
  .faq-q:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq-chev {
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1), color 0.15s ease;
  }
  .faq-q:hover .faq-chev { color: var(--color-accent); }
  /* Without JS the chevron follows [open]; with it, it follows the class so it
     turns the moment you click rather than when the close finishes. */
  .faq:not(.faq-js) .faq-item[open] > .faq-q .faq-chev,
  .faq-js .faq-item.is-open > .faq-q .faq-chev { transform: rotate(180deg); }

  .faq-a {
    overflow: hidden; /* required for the height animation to clip */
    padding-bottom: 1.25rem;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
</style>
