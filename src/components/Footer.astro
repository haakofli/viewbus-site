---
import Wordmark from "./Wordmark.astro";
import { latest } from "../lib/latest";

const year = new Date().getFullYear();

const groups = [
  {
    title: "Product",
    links: [
      { href: "/download/", label: "Download" },
      { href: "/why-viewbus/", label: "Why viewbus" },
      { href: "/#features", label: "Features" },
      { href: "/service-bus-explorer-alternative/", label: "vs Service Bus Explorer" },
      { href: "/changelog/", label: "Changelog" },
    ],
  },
  {
    title: "Developers",
    links: [
      { href: "/mcp-server/", label: "MCP server" },
      { href: "/developers/", label: "Local API" },
      { href: "https://github.com/haakofli/viewbus-site", label: "GitHub", external: true },
      {
        href: "https://github.com/haakofli/viewbus-site/issues/new?template=feature_request.md",
        label: "Request a feature",
        external: true,
      },
      { href: "/llms.txt", label: "llms.txt" },
    ],
  },
  {
    title: "Support & legal",
    links: [
      { href: "/support/", label: "Support" },
      { href: "/privacy/", label: "Privacy" },
      { href: "/terms/", label: "Terms" },
      { href: "https://buymeacoffee.com/hakonlia", label: "Buy me a coffee", external: true },
    ],
  },
];
---
<footer class="mt-20 border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-14">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))] md:gap-8">
      <div class="flex flex-col gap-1">
        <div class="flex items-baseline gap-3">
          <Wordmark size="sm" />
          <span class="font-mono text-xs text-[var(--color-muted)]">v{latest.version}</span>
        </div>
        <p class="text-xs text-[var(--color-muted)] max-w-[24ch]">
          The fastest way to debug Azure Service Bus. Free for Windows and macOS.
        </p>
      </div>

      {groups.map((group) => (
        <nav aria-label={group.title}>
          <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-fg)]">{group.title}</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm text-[var(--color-muted)]">
            {group.links.map(({ href, label, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="transition-colors hover:text-[var(--color-fg)]"
                >{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>viewbus is not affiliated with or endorsed by Microsoft. Azure is a trademark of Microsoft Corporation.</p>
      <p class="font-mono shrink-0">© {year} Håkon Lia</p>
    </div>
  </div>
</footer>
