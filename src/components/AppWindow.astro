---
import LogoMark from "./LogoMark.astro";

const queues = [
  "sb-orders-dev",
  "sb-payments-dev",
  "sb-inventory-dev",
  "sb-customers-dev",
  "sb-shipping-dev",
  "sb-notifications-dev",
];
---
<div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 md:pt-12 pb-12">
  <!-- Mobile: simple centered content, no chrome -->
  <div class="md:hidden py-12">
    <slot />
  </div>

  <!-- Desktop / tablet: full app window -->
  <div class="hidden md:block rounded-[var(--radius-lg)] border border-[var(--color-border)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.7)] overflow-hidden bg-[var(--color-bg)]">
    <!-- TitleBar: 38px -->
    <div class="flex items-stretch h-[38px] border-b border-[var(--color-border)] bg-[var(--color-chrome)] select-none" aria-hidden="true">
      <!-- Logo + wordmark -->
      <div class="flex items-center gap-2 pl-[14px] pr-2">
        <LogoMark variant="color" width={16} height={13} />
        <span class="text-[12px] font-semibold tracking-[-0.01em] leading-none text-[var(--color-fg)]">
          <span class="font-normal opacity-60">view</span><span class="font-semibold">bus</span>
        </span>
      </div>

      <!-- Vertical separator -->
      <div class="my-auto h-[18px] w-px bg-[var(--color-border)]"></div>

      <!-- Breadcrumb: single segment for welcome state -->
      <div class="flex items-center gap-0.5 px-2 text-[12px]">
        <span class="rounded-[3px] px-1.5 py-[3px] text-[var(--color-fg)] whitespace-nowrap">acme-dev</span>
      </div>

      <!-- Drag spacer -->
      <div class="flex-1"></div>

      <!-- Caption buttons: 46px per Fluent spec -->
      <div class="flex items-stretch text-[var(--color-muted)]">
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <line x1="1" y1="5" x2="9" y2="5" />
          </svg>
        </div>
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <rect x="1.5" y="1.5" width="7" height="7" />
          </svg>
        </div>
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <line x1="1" y1="1" x2="9" y2="9" />
            <line x1="9" y1="1" x2="1" y2="9" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Body: sidebar + main -->
    <div class="flex min-h-[520px]">
      <!-- Sidebar -->
      <aside class="hidden lg:flex flex-col w-[240px] border-r border-[var(--color-border)] text-sm select-none bg-[var(--color-chrome)]" aria-hidden="true">
        <!-- Subscription selector: px-2 py-2 gap-1 (from SubscriptionSelector.tsx) -->
        <div class="flex items-center gap-1 px-2 py-2">
          <!-- Select trigger: h-7 px-2.5 text-xs, rounded-md, border, bg (shadcn Select) -->
          <div class="h-7 min-w-0 flex-1 flex items-center justify-between gap-2 px-2.5 rounded-[8px] border border-[var(--color-border)] text-xs">
            <span class="truncate text-[var(--color-fg)]">acme-dev</span>
            <!-- Chevron down, shadcn Select uses lucide ChevronDown size-4 -->
            <svg class="shrink-0 opacity-50" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
          <!-- Refresh button: h-8 w-8 ghost -->
          <div class="size-8 shrink-0 grid place-items-center rounded-[8px] text-[var(--color-fg)]">
            <!-- lucide RefreshCw at size-3.5 -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
              <path d="M8 16H3v5" />
            </svg>
          </div>
          <!-- Collapse button: h-8 w-8 ghost -->
          <div class="size-8 shrink-0 grid place-items-center rounded-[8px] text-[var(--color-fg)]">
            <!-- lucide PanelLeftClose at size-3.5 -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M9 3v18" />
              <path d="m16 15-3-3 3-3" />
            </svg>
          </div>
        </div>

        <!-- Queue tree: text-sm outline-none (from TreeView), each row px-1 py-0.5 rounded-sm hover:bg-accent/50 -->
        <div class="text-sm flex-1 p-1 overflow-hidden">
          <div class="flex flex-col">
            {queues.map((name) => (
              <div class="flex items-center gap-1 rounded-[6px] px-1 py-0.5" style="padding-left: 4px;">
                <!-- Chevron slot: w-5 shrink-0 flex items-center justify-center -->
                <span class="flex w-5 shrink-0 items-center justify-center">
                  <!-- lucide ChevronRight size-3.5 text-muted-foreground -->
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)]">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </span>
                <!-- Namespace icon: lucide ServerIcon at size-3.5 text-muted-foreground -->
                <span class="shrink-0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)]">
                    <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
                    <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
                    <line x1="6" x2="6.01" y1="6" y2="6" />
                    <line x1="6" x2="6.01" y1="18" y2="18" />
                  </svg>
                </span>
                <span class="min-w-0 truncate">{name}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Footer: MCP + Settings + user — from Sidebar.tsx: border-t p-1.5 space-y-0.5 -->
        <nav class="border-t border-[var(--color-border)] p-1.5 space-y-0.5">
          <!-- Connect MCP: ghost button w-full justify-start text-xs, icon size-3.5 -->
          <div class="flex h-7 items-center gap-1 px-2.5 rounded-[8px] text-[12px] text-[var(--color-fg)]">
            <!-- lucide Plug -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M12 22v-5" />
              <path d="M9 8V2" />
              <path d="M15 8V2" />
              <path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z" />
            </svg>
            <span>Connect MCP</span>
          </div>
          <!-- Settings -->
          <div class="flex h-7 items-center gap-1 px-2.5 rounded-[8px] text-[12px] text-[var(--color-fg)]">
            <!-- lucide Settings -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <span>Settings</span>
          </div>
          <!-- User email -->
          <div class="flex h-7 items-center gap-1 px-2.5 rounded-[8px] text-[12px] text-[var(--color-fg)] truncate">
            <!-- lucide User -->
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span class="truncate">you@example.com</span>
          </div>
        </nav>
      </aside>

      <!-- Main panel: welcome content + tip — from WelcomeScreen.tsx layout -->
      <main class="flex-1 flex flex-col bg-[var(--color-bg)]">
        <div class="flex-1 flex items-center justify-center px-6 py-10">
          <slot />
        </div>
        <!-- Tip styled from WelcomeTips.tsx: border-t border-border/50 px-4 py-2 text-xs text-muted-foreground -->
        <div class="border-t border-[var(--color-border)]/50 px-4 py-2 text-xs text-[var(--color-muted)] text-center">
          <span class="mr-2 text-[var(--color-muted-dim)]">Tip:</span>
          <span>ViewBus exposes an MCP server — your AI assistant can peek queues, inspect messages, and trace an ID across your whole namespace.</span>
        </div>
      </main>
    </div>
  </div>
</div>
