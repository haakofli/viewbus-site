---
import LogoMark from "./LogoMark.astro";

const queues = [
  "sb-orders-dev",
  "sb-payments-dev",
  "sb-inventory-dev",
  "sb-customers-dev",
  "sb-shipping-dev",
  "sb-notifications-dev",
];
---
<div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 md:pt-12 pb-12">
  <!-- Mobile: simple centered content, no chrome -->
  <div class="md:hidden py-12">
    <slot />
  </div>

  <!-- Desktop / tablet: full app window -->
  <div class="hidden md:block rounded-[var(--radius-lg)] border border-[var(--color-border)] shadow-[0_30px_80px_-30px_rgba(0,0,0,0.7)] overflow-hidden bg-[var(--color-bg)]">
    <!-- TitleBar: 38px -->
    <div class="flex items-stretch h-[38px] border-b border-[var(--color-border)] bg-[var(--color-chrome)] select-none" aria-hidden="true">
      <!-- Logo + wordmark -->
      <div class="flex items-center gap-2 pl-[14px] pr-2">
        <LogoMark variant="color" width={16} height={13} />
        <span class="text-[12px] font-semibold tracking-[-0.01em] leading-none text-[var(--color-fg)]">
          <span class="font-normal opacity-60">view</span><span class="font-semibold">bus</span>
        </span>
      </div>

      <!-- Vertical separator -->
      <div class="my-auto h-[18px] w-px bg-[var(--color-border)]"></div>

      <!-- Breadcrumb: single segment for welcome state -->
      <div class="flex items-center gap-0.5 px-2 text-[12px] text-[var(--color-muted)]">
        <span class="rounded-[3px] px-1.5 py-[3px] text-[var(--color-fg)] whitespace-nowrap">acme-dev</span>
      </div>

      <!-- Drag spacer -->
      <div class="flex-1"></div>

      <!-- Caption buttons: 46px per Fluent spec -->
      <div class="flex items-stretch text-[var(--color-muted)]">
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <line x1="1" y1="5" x2="9" y2="5" />
          </svg>
        </div>
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <rect x="1.5" y="1.5" width="7" height="7" />
          </svg>
        </div>
        <div class="w-[46px] grid place-items-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1" shape-rendering="geometricPrecision">
            <line x1="1" y1="1" x2="9" y2="9" />
            <line x1="9" y1="1" x2="1" y2="9" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Body: sidebar + main -->
    <div class="flex min-h-[520px]">
      <!-- Sidebar -->
      <aside class="hidden lg:flex flex-col w-[240px] border-r border-[var(--color-border)] text-sm select-none bg-[var(--color-chrome)]" aria-hidden="true">
        <!-- Subscription selector -->
        <div class="border-b border-[var(--color-border)] p-2 flex items-center gap-1">
          <div class="flex-1 flex items-center justify-between px-2.5 py-1.5 border border-[var(--color-border)] rounded-[var(--radius-sm)] text-[13px] text-[var(--color-fg)]">
            <span class="truncate">acme-dev</span>
            <svg width="10" height="6" viewBox="0 0 10 6" class="text-[var(--color-muted)] shrink-0"><path d="M1 1.5L5 4.5L9 1.5" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" /></svg>
          </div>
          <div class="p-1.5 text-[var(--color-muted)]">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
              <path d="M12 7a5 5 0 1 1-1.5-3.5" />
              <path d="M12 1.5V4h-2.5" />
            </svg>
          </div>
          <div class="p-1.5 text-[var(--color-muted)]">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
              <rect x="1.5" y="2.5" width="11" height="9" rx="1" />
              <line x1="5.5" y1="2.5" x2="5.5" y2="11.5" />
            </svg>
          </div>
        </div>

        <!-- Queue tree -->
        <ul class="p-1 flex-1 space-y-0.5 overflow-hidden">
          {queues.map((name) => (
            <li class="flex items-center gap-1.5 px-2 py-1 text-[var(--color-fg)] text-[13px]">
              <svg width="8" height="10" viewBox="0 0 8 10" class="text-[var(--color-muted)] shrink-0"><path d="M2.5 2L6 5L2.5 8" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" /></svg>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-[var(--color-muted)] shrink-0" stroke="currentColor" stroke-width="1.1">
                <rect x="1.5" y="2" width="11" height="2.5" rx="0.5" />
                <rect x="1.5" y="5.75" width="11" height="2.5" rx="0.5" />
                <rect x="1.5" y="9.5" width="11" height="2.5" rx="0.5" />
              </svg>
              <span class="truncate">{name}</span>
            </li>
          ))}
        </ul>

        <!-- Footer: MCP + Settings + user -->
        <nav class="border-t border-[var(--color-border)] p-1.5 space-y-0.5 text-[var(--color-muted)] text-[12px]">
          <div class="flex items-center gap-2 px-2 py-1.5">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="6.5" width="9" height="5.5" rx="0.5" />
              <path d="M4.5 6.5V4.2a2.5 2.5 0 0 1 5 0v2.3" />
            </svg>
            <span>Connect MCP</span>
          </div>
          <div class="flex items-center gap-2 px-2 py-1.5">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="7" cy="7" r="2" />
              <path d="M11.5 7c0 .3-.05.7-.1 1l1 .9-1 1.7-1.3-.4c-.5.4-1.1.7-1.7.9L8 12.5H6L5.6 11.1c-.6-.2-1.2-.5-1.7-.9l-1.3.4-1-1.7 1-.9c-.05-.3-.1-.7-.1-1s.05-.7.1-1l-1-.9 1-1.7 1.3.4c.5-.4 1.1-.7 1.7-.9L6 1.5h2l.4 1.4c.6.2 1.2.5 1.7.9l1.3-.4 1 1.7-1 .9c.05.3.1.7.1 1z" />
            </svg>
            <span>Settings</span>
          </div>
          <div class="flex items-center gap-2 px-2 py-1.5 truncate">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="7" cy="5" r="2.5" />
              <path d="M2 12c1-2.5 2.5-3.5 5-3.5s4 1 5 3.5" />
            </svg>
            <span class="truncate">you@example.com</span>
          </div>
        </nav>
      </aside>

      <!-- Main panel: welcome content + tip -->
      <main class="flex-1 flex flex-col">
        <div class="flex-1 flex items-center justify-center px-6 py-10">
          <slot />
        </div>
        <div class="border-t border-[var(--color-border)]/50 px-4 py-2 text-xs text-[var(--color-muted)] text-center">
          <span class="mr-2 text-[var(--color-muted)]/60">Tip:</span>
          <span>ViewBus exposes an MCP server — your AI assistant can peek queues, inspect messages, and trace an ID across your whole namespace.</span>
        </div>
      </main>
    </div>
  </div>
</div>
