---
const features = [
  {
    id: "browse",
    label: "Browse",
    title: "Fast tree browsing",
    body: "Subscriptions, namespaces, queues, topics — indexed locally in SQLite. Navigation is instant, even on enterprise tenants with thousands of resources.",
  },
  {
    id: "messages",
    label: "Messages",
    title: "Browse and act on messages",
    body: "Peek active and dead-letter messages without dequeuing. Filter by session, ID, subject, or DL reason. Requeue, edit, or bulk-delete with a safety confirmation.",
  },
  {
    id: "spotlight",
    label: "Spotlight",
    title: "Spotlight search",
    body: "Ctrl+I opens a system-wide fuzzy search across every indexed resource. Stays active even with viewbus closed to the tray.",
  },
  {
    id: "mcp",
    label: "MCP",
    title: "Built-in MCP server",
    body: "Ships a Model Context Protocol server so Claude, ChatGPT, or any MCP-aware AI can list namespaces, search resources, peek queues, and fetch full messages.",
  },
  {
    id: "themes",
    label: "Themes",
    title: "Themes & VS Code import",
    body: "Dark, light, or custom user themes. One-click importer pulls your active VS Code theme into viewbus.",
  },
];

const mcpTools = [
  { name: "get_status", note: "index state + last refresh" },
  { name: "list_namespaces", note: "azure subscription namespaces" },
  { name: "list_queues", note: "queues in a namespace" },
  { name: "list_topics", note: "topics in a namespace" },
  { name: "list_subscriptions", note: "subs under a topic" },
  { name: "get_resource", note: "full detail for a resource" },
  { name: "search_resources", note: "fuzzy across names + paths" },
  { name: "count_messages", note: "active + dead-letter totals" },
  { name: "peek_messages", note: "read without dequeuing" },
  { name: "get_message_detail", note: "body + properties by seq no." },
];

// Message rows mirror real MessageRow: #seq, time, DL reason, session, subject.
const messageRows = [
  { id: "664134", time: "18/08 14:23", reason: "LookupNotCreatedYetException", session: "2000081270", subject: "sap.s4.beh.order.v1.order.event", selected: true },
  { id: "664138", time: "18/08 14:23", reason: "LookupNotCreatedYetException", session: "2000081270", subject: "sap.s4.beh.order.v1.order.event", selected: true },
  { id: "664300", time: "18/08 14:23", reason: "LookupNotCreatedYetException", session: "2000076994", subject: "sap.s4.beh.order.v1.order.event", selected: false },
  { id: "664305", time: "18/08 14:23", reason: "LookupNotCreatedYetException", session: "2000076994", subject: "sap.s4.beh.order.v1.order.event", selected: false },
  { id: "664500", time: "18/08 14:24", reason: "InvalidOperationException", session: "2000075761", subject: "sap.s4.beh.order.v1.order.event", selected: true },
  { id: "664504", time: "18/08 14:24", reason: "InvalidOperationException", session: "2000075761", subject: "sap.s4.beh.order.v1.order.event", selected: false },
];

// Sidebar namespaces for the Browse tab
const browseNamespaces = [
  {
    name: "sb-orders-dev",
    expanded: true,
    children: [
      { name: "api~orders~placement", active: 0, dead: 0, selected: false },
      { name: "integration~from~erp~order-events", active: 0, dead: 12, selected: true },
      { name: "private~orders~processor", active: 2, dead: 0, selected: false },
    ],
  },
  { name: "sb-payments-dev", expanded: false },
  { name: "sb-inventory-dev", expanded: false },
  { name: "sb-customers-dev", expanded: false },
  { name: "sb-shipping-dev", expanded: false },
  { name: "sb-notifications-dev", expanded: false },
];
---
<section id="features" data-snap-to="features" class="max-w-6xl mx-auto px-6 py-24 scroll-mt-20">
  <h2 class="reveal text-3xl md:text-4xl font-bold mb-4 tracking-tight">
    Built for the way developers actually use Service Bus.
  </h2>
  <p class="reveal text-[var(--color-muted)] mb-12 max-w-2xl">
    Everything you'd want Service Bus Explorer to be, without the legacy baggage.
  </p>

  <div class="reveal feature-tabs">
    <!-- Tab list -->
    <div role="tablist" aria-label="Feature categories" class="flex flex-wrap gap-1 border-b border-[var(--color-border)] mb-10">
      {features.map((f, i) => (
        <button
          type="button"
          role="tab"
          id={`ft-tab-${f.id}`}
          aria-controls={`ft-panel-${f.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="ft-tab relative px-4 py-2.5 text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-fg)] transition-colors cursor-pointer border-b-2 border-transparent -mb-px"
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Tab panels -->
    <div class="ft-panels">
      {features.map((f, i) => (
        <div
          role="tabpanel"
          id={`ft-panel-${f.id}`}
          aria-labelledby={`ft-tab-${f.id}`}
          hidden={i !== 0}
          class="ft-panel grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] gap-8 lg:gap-16 items-center md:min-h-[520px]"
        >
          <!-- Copy -->
          <div>
            <h3 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">{f.title}</h3>
            <p class="text-[var(--color-muted)] leading-relaxed">{f.body}</p>
          </div>

          <!-- Visual -->
          <div class="ft-visual">

            {/* BROWSE — standalone sidebar mini render */}
            {f.id === "browse" && (
              <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-chrome)] overflow-hidden shadow-[0_20px_60px_-30px_rgba(0,0,0,0.6)] flex flex-col max-w-[300px]">
                <!-- Subscription selector row -->
                <div class="flex items-center gap-1 px-2 py-2">
                  <div class="h-7 min-w-0 flex-1 flex items-center justify-between gap-2 px-2.5 rounded-[8px] border border-[var(--color-border)] text-xs">
                    <span class="truncate text-[var(--color-fg)]">acme-dev</span>
                    <svg class="shrink-0 opacity-50" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                  </div>
                  <div class="size-8 shrink-0 grid place-items-center rounded-[8px] text-[var(--color-fg)]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
                      <path d="M21 3v5h-5" />
                      <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
                      <path d="M8 16H3v5" />
                    </svg>
                  </div>
                  <div class="size-8 shrink-0 grid place-items-center rounded-[8px] text-[var(--color-fg)]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="2" />
                      <path d="M9 3v18" />
                      <path d="m16 15-3-3 3-3" />
                    </svg>
                  </div>
                </div>

                <!-- Tree -->
                <div class="text-sm p-1 flex-1">
                  {browseNamespaces.map((ns) => (
                    <>
                      <div class="flex items-center gap-1 rounded-[6px] px-1 py-0.5 text-[var(--color-fg)] text-[13px]" style="padding-left: 4px;">
                        <span class="flex w-5 shrink-0 items-center justify-center">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class:list={["text-[var(--color-muted)] transition-transform duration-150", ns.expanded && "rotate-90"]}><path d="m9 18 6-6-6-6" /></svg>
                        </span>
                        <span class="shrink-0">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)]">
                            <rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/>
                            <line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>
                          </svg>
                        </span>
                        <span class="min-w-0 truncate">{ns.name}</span>
                      </div>
                      {ns.expanded && ns.children?.map((q) => (
                        <div class:list={["relative flex items-center gap-1 rounded-[6px] px-1 py-0.5 text-[13px]", q.selected && "bg-[var(--color-hover)]"]} style="padding-left: 16px;">
                          {q.selected && <span class="absolute left-0 top-1 bottom-1 w-0.5 rounded-full bg-[var(--color-accent)]"></span>}
                          <span class="w-5 shrink-0"></span>
                          <span class="shrink-0">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)]">
                              <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/>
                              <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
                            </svg>
                          </span>
                          <span class="min-w-0 truncate text-[var(--color-fg)]">{q.name}</span>
                          <span class="ml-auto flex shrink-0 items-center gap-1.5 pl-2 text-[10px] font-medium tabular-nums">
                            <span class={q.active > 0 ? "text-[var(--color-success)]" : "text-[var(--color-muted)]"}>{q.active}</span>
                            <span class={q.dead > 0 ? "text-[var(--color-danger)]" : "text-[var(--color-muted)]"}>{q.dead}</span>
                          </span>
                        </div>
                      ))}
                    </>
                  ))}
                </div>

                <!-- Footer (Connect MCP, Settings, user) -->
                <nav class="border-t border-[var(--color-border)] p-1.5 space-y-0.5">
                  <div class="flex h-7 items-center gap-1 px-2.5 rounded-[8px] text-[12px] text-[var(--color-fg)]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
                    <span>Connect MCP</span>
                  </div>
                  <div class="flex h-7 items-center gap-1 px-2.5 rounded-[8px] text-[12px] text-[var(--color-fg)]">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                    <span>Settings</span>
                  </div>
                </nav>
              </div>
            )}

            {/* MESSAGES — faithful QueueHeader + MessageList */}
            {f.id === "messages" && (
              <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg)] overflow-hidden shadow-[0_20px_60px_-30px_rgba(0,0,0,0.6)]">
                <!-- Row 1: title + selection-state actions -->
                <div class="flex items-center gap-3 px-4 py-2 min-w-0">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 min-w-0">
                      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="shrink-0 text-[var(--color-fg)]/80">
                        <path d="M2 4l6 4 6-4M2 4v8h12V4" stroke="currentColor" stroke-width="1.2" />
                      </svg>
                      <h4 class="truncate text-sm font-semibold min-w-0">integration~from~erp~order-events</h4>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2 font-mono text-[11px] text-[var(--color-muted)]/70">
                      <span class="tabular-nums">max-size 5GB</span>
                      <span class="text-[var(--color-muted)]/40">·</span>
                      <span class="tabular-nums">sessions on</span>
                    </div>
                  </div>
                  <!-- Selection-state actions -->
                  <div class="flex shrink-0 items-center gap-1">
                    <span class="inline-flex h-7 items-center gap-1.5 rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] px-2.5 text-[11.5px] font-medium">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 3 9-3 9 19-9z"/><path d="M6 12h16"/></svg>
                      <span class="tabular-nums">Resend 3</span>
                    </span>
                    <span class="inline-flex h-7 items-center gap-1.5 rounded-md border border-[var(--color-border)] px-2.5 text-[11.5px] text-[var(--color-danger)]">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      <span>Delete</span>
                    </span>
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-[var(--color-border)]">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)]"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                    </span>
                  </div>
                </div>

                <!-- Row 2: mode switch + peek + meta -->
                <div class="flex items-center gap-3 px-4 py-2">
                  <!-- ModeSwitch -->
                  <div class="flex h-7 items-center gap-0.5 rounded-md border border-[var(--color-border)] bg-[var(--color-hover)]/40 p-0.5">
                    <div class="flex h-6 items-center gap-1.5 rounded px-3 text-[11.5px] text-[var(--color-muted)]">
                      <span>Active</span>
                      <span class="font-mono text-[10px] tabular-nums">0</span>
                    </div>
                    <div class="flex h-6 items-center gap-1.5 rounded px-3 text-[11.5px] bg-[var(--color-bg)]" style="box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-danger) 28%, transparent)">
                      <span class="text-[var(--color-danger)]">Dead-letter</span>
                      <span class="font-mono text-[10px] tabular-nums text-[var(--color-danger)]">73</span>
                    </div>
                  </div>
                  <div class="h-4 w-px bg-[var(--color-border)]"></div>
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex h-7 items-center rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] min-w-[84px] justify-center px-3.5 text-[11.5px] font-medium tabular-nums">Peek 20</span>
                    <span class="inline-flex h-7 items-center rounded-md border border-[var(--color-border)] px-3 text-[11.5px] text-[var(--color-muted)]">Peek all</span>
                  </div>
                  <div class="ml-auto flex items-center gap-1.5 text-[11px] text-[var(--color-muted)]">
                    <span class="font-mono tabular-nums text-[var(--color-fg)]">3</span>
                    <span>selected</span>
                    <span class="text-[var(--color-muted)]/60">·</span>
                    <span class="text-[var(--color-fg)]">Clear</span>
                  </div>
                </div>

                <!-- Row 3: search + time + filter -->
                <div class="flex items-center gap-2 px-4 py-2">
                  <div class="flex h-7 flex-1 items-center gap-2 rounded-md border border-[var(--color-border)] bg-[var(--color-hover)]/40 px-2.5 text-xs">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-[var(--color-muted)]"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <span class="flex-1 text-[var(--color-muted)]/60">Search message body…</span>
                    <span class="font-mono text-[10px] text-[var(--color-muted)]/60">/</span>
                  </div>
                  <span class="inline-flex h-7 items-center gap-1.5 rounded-md border border-[var(--color-border)] px-2.5 text-[11px] text-[var(--color-muted)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span>Any time</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
                  </span>
                  <span class="inline-flex h-7 items-center gap-1 rounded-md border border-[var(--color-border)] px-2.5 text-[11px] text-[var(--color-muted)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>filter</span>
                  </span>
                </div>

                <!-- spacer -->
                <div class="h-2"></div>

                <!-- Table header -->
                <div class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-hover)]/30 px-4 py-2">
                  <span class="inline-flex w-3 h-3 shrink-0 rounded-sm border border-[var(--color-border)]"></span>
                  <span class="w-14 shrink-0 text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">#</span>
                  <span class="w-20 shrink-0 text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">Enqueued</span>
                  <span class="w-32 shrink-0 truncate text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">DL Reason</span>
                  <span class="w-20 shrink-0 text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">Session</span>
                  <span class="min-w-0 truncate text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">Subject / Type</span>
                </div>

                <!-- Rows -->
                {messageRows.map((row) => (
                  <div class:list={["flex cursor-pointer items-center gap-2 border-b border-[var(--color-border)]/50 px-4 py-1.5", row.selected && "bg-[var(--color-hover)]"]}>
                    <span class:list={["inline-flex w-3 h-3 shrink-0 rounded-sm border", row.selected ? "bg-[var(--color-accent)] border-[var(--color-accent)]" : "border-[var(--color-border)]"]}>
                      {row.selected && (
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-[var(--color-bg)]"><polyline points="20 6 9 17 4 12"/></svg>
                      )}
                    </span>
                    <span class="w-14 shrink-0 truncate text-[11px] font-medium tabular-nums text-[var(--color-muted)]">#{row.id}</span>
                    <span class="w-20 shrink-0 text-[11px] text-[var(--color-muted)]">{row.time}</span>
                    <span class="w-32 shrink-0 truncate text-[11px] text-[var(--color-danger)]/70">{row.reason}</span>
                    <span class="w-20 shrink-0 truncate text-[11px] text-[var(--color-info)]/70 font-mono tabular-nums">{row.session}</span>
                    <span class="min-w-0 truncate text-[11px] text-[var(--color-fg)]/50">{row.subject}</span>
                  </div>
                ))}
              </div>
            )}

            {/* SPOTLIGHT — floating panel, no extra chrome */}
            {f.id === "spotlight" && (
              <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] shadow-2xl overflow-hidden max-w-[500px] mx-auto">
                <!-- Search row -->
                <div class="flex items-center gap-2 border-b border-[var(--color-border)] px-3 py-2.5">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-[var(--color-muted)] shrink-0"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                  <span class="flex-1 text-sm text-[var(--color-fg)]">orders dead</span>
                  <span class="inline-block w-0.5 h-4 bg-[var(--color-accent)] animate-pulse"></span>
                  <span class="shrink-0 rounded bg-[var(--color-hover)] px-2 py-0.5 text-[11px] text-[var(--color-muted)] border border-[var(--color-border)] font-mono">acme-dev</span>
                </div>

                <!-- Results -->
                <div class="py-1">
                  <div class="px-3 py-1 text-[10px] font-medium uppercase tracking-wide text-[var(--color-muted)]">Queues</div>
                  {[
                    { name: "integration~from~erp~order-events", path: "sb-orders-dev", active: 0, dead: 12, selected: true },
                    { name: "private~orders~processor", path: "sb-orders-dev", active: 2, dead: 0, selected: false },
                    { name: "api~orders~placement", path: "sb-orders-dev", active: 0, dead: 0, selected: false },
                  ].map((r) => (
                    <div class:list={["flex items-center gap-2 px-3 py-1.5", r.selected && "bg-[var(--color-hover)]"]}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-muted)] shrink-0">
                        <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/>
                        <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
                      </svg>
                      <div class="min-w-0 flex-1">
                        <div class="truncate text-sm">{r.name}</div>
                        <div class="truncate text-[11px] text-[var(--color-muted)]">{r.path}</div>
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <span class:list={["text-[10px] font-medium tabular-nums", r.active > 0 ? "text-[var(--color-success)]" : "text-[var(--color-muted)]/50"]}>{r.active}</span>
                        <span class:list={["text-[10px] font-medium tabular-nums", r.dead > 0 ? "text-[var(--color-danger)]" : "text-[var(--color-muted)]/50"]}>{r.dead}</span>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Footer hints -->
                <div class="flex items-center gap-4 border-t border-[var(--color-border)] px-3 py-1.5 text-[10px] text-[var(--color-muted)]">
                  <span>↑↓ Navigate</span>
                  <span>↵ Select</span>
                  <span>Esc Close</span>
                </div>
              </div>
            )}

            {/* MCP — terminal-style tool list */}
            {f.id === "mcp" && (
              <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-chrome)] overflow-hidden shadow-[0_20px_60px_-30px_rgba(0,0,0,0.6)] font-mono text-[11.5px]">
