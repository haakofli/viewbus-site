---
const features = [
  {
    id: "browse",
    label: "Browse",
    title: "Fast tree browsing",
    body: "Subscriptions, namespaces, queues, topics — indexed locally in SQLite. Navigation is instant, even on enterprise tenants with thousands of resources.",
  },
  {
    id: "messages",
    label: "Messages",
    title: "Browse and act on messages",
    body: "Peek active and dead-letter messages without dequeuing. Filter by session, ID, subject, or DL reason. Edit a body before resending, compose new messages, or drain a queue with a confirmed bulk action — purge, send-all-to-DL, or empty an entire DLQ.",
  },
  {
    id: "spotlight",
    label: "Spotlight",
    title: "Spotlight search",
    body: "Ctrl+I opens a system-wide fuzzy search across every indexed resource. Stays active even with viewbus closed to the tray.",
  },
  {
    id: "mcp",
    label: "MCP",
    title: "Built-in MCP server",
    body: "Ships a Model Context Protocol server so Claude, ChatGPT, or any MCP-aware AI can list namespaces, search resources, peek queues, and fetch full messages.",
  },
  {
    id: "themes",
    label: "Themes",
    title: "Built-in themes & VS Code import",
    body: "Six built-in dark and light themes — including a warm Clave theme. One-click importer pulls your active VS Code theme into viewbus.",
  },
];

const mcpTools = [
  { name: "get_status", note: "index state + last refresh" },
  { name: "list_namespaces", note: "azure subscription namespaces" },
  { name: "list_queues", note: "queues in a namespace" },
  { name: "list_topics", note: "topics in a namespace" },
  { name: "list_subscriptions", note: "subs under a topic" },
  { name: "get_resource", note: "full detail for a resource" },
  { name: "search_resources", note: "fuzzy across names + paths" },
  { name: "count_messages", note: "active + dead-letter totals" },
  { name: "peek_messages", note: "read without dequeuing" },
  { name: "get_message_detail", note: "body + properties by seq no." },
];

const visualMaxWidth: Record<string, string> = {
  browse: "max-w-[280px]",
  messages: "max-w-[560px]",
  spotlight: "max-w-[480px]",
  mcp: "max-w-[480px]",
  themes: "max-w-[560px]",
};
---
<section id="features" data-snap-to="features" class="max-w-6xl mx-auto px-6 py-20 md:py-24 scroll-mt-20">
  <h2 class="reveal text-3xl md:text-4xl font-bold mb-4 tracking-tight text-center">
    Built for the way developers actually use Service Bus.
  </h2>
  <p class="reveal text-[var(--color-muted)] mb-10 md:mb-12 max-w-2xl mx-auto text-center">
    Everything you'd want Service Bus Explorer to be, without the legacy baggage.
  </p>

  <div
    class="reveal ft-carousel relative"
    role="region"
    aria-roledescription="carousel"
    aria-label="viewbus features"
  >
    <!-- Track. Native scroll-snap handles swipe / trackpad scroll;
         buttons and dots drive the same scrollTo programmatically. -->
    <div class="ft-track" tabindex="0" aria-live="polite">
      {features.map((f, i) => (
        <article
          class="ft-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${features.length}: ${f.title}`}
          data-index={i}
        >
          <div class="grid md:grid-cols-2 gap-10 md:gap-12 lg:gap-16 items-center px-2 md:px-10 lg:px-16">
            <div class="md:max-w-md md:justify-self-end">
              <h3 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">{f.title}</h3>
              <p class="text-[var(--color-muted)] leading-relaxed">{f.body}</p>
            </div>
            <div class="flex justify-center md:justify-start min-w-0">
              {f.id === "mcp" ? (
                <div class={`dark-card lifted w-full rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg)] overflow-hidden font-mono text-[11.5px] ${visualMaxWidth[f.id]}`}>
                  <div class="h-7 border-b border-[var(--color-border)] flex items-center px-3 gap-2 text-[10px] text-[var(--color-muted)]">
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="ml-2">viewbus-mcp</span>
                  </div>
                  <div class="p-4 space-y-0.5 text-[var(--color-fg)]">
                    <div class="text-[var(--color-muted)]">$ viewbus-mcp --list-tools</div>
                    <div class="text-[var(--color-accent)]">10 read-only tools · 1 opt-in write tool</div>
                    <div class="h-2"></div>
                    {mcpTools.map((t) => (
                      <div class="flex gap-3">
                        <span class="text-[var(--color-success)] shrink-0">{t.name}</span>
                        <span class="text-[var(--color-muted)] truncate">{t.note}</span>
                      </div>
                    ))}
                    <div class="h-2"></div>
                    <div class="text-[var(--color-muted)]">
                      <span class="text-[var(--color-fg)]">upsert_theme</span>
                      <span class="ml-3">write · opt-in via settings</span>
                    </div>
                  </div>
                </div>
              ) : (
                <div class={`dark-card lifted w-full rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg)] ${visualMaxWidth[f.id]}`}>
                  <img
                    src={`/screenshots/feature-${f.id}.png`}
                    alt={f.title}
                    loading="lazy"
                    decoding="async"
                    class="block w-full h-auto"
                  />
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Prev / Next nav. Hidden on touch-only / narrow screens — swipe is faster. -->
    <button type="button" class="ft-nav ft-prev lifted-sm" aria-label="Previous feature" data-direction="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <button type="button" class="ft-nav ft-next lifted-sm" aria-label="Next feature" data-direction="1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>

    <!-- Dot indicators. Width grows on the active dot for a clear "you are here". -->
    <div class="ft-dots" role="tablist" aria-label="Choose feature slide">
      {features.map((f, i) => (
        <button
          type="button"
          role="tab"
          aria-label={f.title}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-dot
          data-index={i}
          class="ft-dot"
        ></button>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const AUTOPLAY_MS = 6000;

    document.querySelectorAll(".ft-carousel").forEach((root) => {
      const track = root.querySelector(".ft-track");
      const slides = Array.from(root.querySelectorAll(".ft-slide"));
      const dots = Array.from(root.querySelectorAll("[data-dot]"));
      const prev = root.querySelector(".ft-prev");
      const next = root.querySelector(".ft-next");
      if (!track || slides.length === 0) return;

      let current = 0;
      let autoplayTimer = null;
      let inView = false;
      let interacted = false;
      let scrollSettleTimer = null;

      const updateDots = () => {
        dots.forEach((dot, i) => {
          dot.setAttribute("aria-selected", i === current ? "true" : "false");
          dot.setAttribute("tabindex", i === current ? "0" : "-1");
        });
      };

      const goTo = (index) => {
        const wrapped = ((index % slides.length) + slides.length) % slides.length;
        const target = slides[wrapped];
        // When the autoplay wraps from the last slide back to the first
        // (or someone clicks the prev button on slide 0), jump instantly
        // instead of animating the whole track backwards.
        const isLongJump = Math.abs(wrapped - current) > 1;
        track.scrollTo({
          left: target.offsetLeft - track.offsetLeft,
          behavior: isLongJump ? "auto" : "smooth",
        });
        current = wrapped;
        updateDots();
      };

      const startAutoplay = () => {
        if (interacted || autoplayTimer !== null) return;
        autoplayTimer = window.setInterval(() => {
          goTo(current + 1);
        }, AUTOPLAY_MS);
      };

      const stopAutoplay = () => {
        if (autoplayTimer !== null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const sync = () => {
        if (inView && !interacted) startAutoplay();
        else stopAutoplay();
      };

      const markInteracted = () => {
        interacted = true;
        stopAutoplay();
      };

      // Prev / Next buttons
      [prev, next].forEach((btn) => {
        if (!btn) return;
        btn.addEventListener("click", () => {
          markInteracted();
          const dir = parseInt(btn.getAttribute("data-direction") || "1", 10);
          goTo(current + dir);
        });
      });

      // Dots
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          markInteracted();
          goTo(i);
        });
        dot.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
            e.preventDefault();
            markInteracted();
            const delta = e.key === "ArrowRight" ? 1 : -1;
            goTo(current + delta);
            dots[current].focus();
          }
        });
      });

      // Track keyboard nav (focus the track, then arrow keys scroll panels)
      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          markInteracted();
          goTo(current + (e.key === "ArrowRight" ? 1 : -1));
        }
      });

      // Native scroll (swipe / trackpad) — sync index to whichever slide
      // ended up centered after the user finished scrolling.
      track.addEventListener("scroll", () => {
        if (scrollSettleTimer) clearTimeout(scrollSettleTimer);
        scrollSettleTimer = window.setTimeout(() => {
          const trackRect = track.getBoundingClientRect();
          const trackCenter = trackRect.left + trackRect.width / 2;
          let closest = current;
          let closestDist = Infinity;
          slides.forEach((s, i) => {
            const r = s.getBoundingClientRect();
            const slideCenter = r.left + r.width / 2;
            const dist = Math.abs(slideCenter - trackCenter);
            if (dist < closestDist) {
              closest = i;
              closestDist = dist;
            }
          });
          if (closest !== current) {
            current = closest;
            updateDots();
            // Treat manual swipe as user interaction.
            markInteracted();
          }
        }, 120);
      });

      // Hover pause (resume on leave, unless user has clicked / swiped)
      root.addEventListener("mouseenter", stopAutoplay);
      root.addEventListener("mouseleave", () => { if (!interacted) startAutoplay(); });

      // Pause when tab is hidden.
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopAutoplay();
        else sync();
      });

      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) inView = entry.isIntersecting;
            sync();
          },
          { threshold: 0.1 }
        ).observe(root);
      } else {
        inView = true;
        sync();
      }

      updateDots();
    });
  })();
</script>
