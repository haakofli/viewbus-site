---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import browseShot from "../assets/screenshots/feature-browse.png";
import messagesShot from "../assets/screenshots/feature-messages.png";
import operationsShot from "../assets/screenshots/feature-operations.png";
import monitoringShot from "../assets/screenshots/feature-monitoring.png";
import spotlightShot from "../assets/screenshots/feature-spotlight.png";
import themesShot from "../assets/screenshots/feature-themes.png";

const features = [
  {
    id: "browse",
    label: "Browse",
    title: "Fast tree browsing",
    body: "Subscriptions, namespaces, queues, topics — indexed locally in SQLite. Navigation is instant, even on enterprise tenants with thousands of resources.",
  },
  {
    id: "messages",
    label: "Messages",
    title: "Browse and act on messages",
    body: "Peek active and dead-letter messages without dequeuing. Filter by session, ID, subject, or DL reason. Edit a body before resending, or compose new messages from scratch.",
    wide: true,
  },
  {
    id: "operations",
    label: "Operations",
    title: "Run queue operations in bulk",
    body: "Purge, dead-letter, resend, or delete across a whole queue or DLQ from one place. Preview and filter the batch first, then watch each job run live — progress, an ETA, and a history of every operation that's run.",
    isNew: true,
    wide: true,
  },
  {
    id: "monitoring",
    label: "Monitoring",
    title: "Set up automatic monitoring and alerting",
    body: "Pick exactly which queues, topics, and subscriptions to watch, and which ones should alert. Runs in the background at a low cost to your machine.",
    wide: true,
  },
  {
    id: "spotlight",
    label: "Spotlight",
    title: "Spotlight search",
    body: "Ctrl+I opens a system-wide fuzzy search across every indexed resource. Stays active even with viewbus closed to the tray.",
  },
  {
    id: "mcp",
    label: "MCP",
    title: "Built-in MCP server",
    body: "Ships a Model Context Protocol server so Claude, ChatGPT, or any MCP-aware AI can list namespaces, search resources, peek queues, and fetch full messages.",
  },
  {
    id: "themes",
    label: "Themes",
    title: "Built-in themes & VS Code import",
    body: "Six built-in dark and light themes — including a warm Clave theme. One-click importer pulls your active VS Code theme into viewbus.",
  },
];

const mcpTools = [
  { name: "get_status", note: "index state + last refresh" },
  { name: "list_namespaces", note: "azure subscription namespaces" },
  { name: "list_queues", note: "queues in a namespace" },
  { name: "list_topics", note: "topics in a namespace" },
  { name: "list_subscriptions", note: "subs under a topic" },
  { name: "get_resource", note: "full detail for a resource" },
  { name: "search_resources", note: "fuzzy across names + paths" },
  { name: "count_messages", note: "active + dead-letter totals" },
  { name: "peek_messages", note: "read without dequeuing" },
  { name: "get_message_detail", note: "body + properties by seq no." },
];

const visualMaxWidth: Record<string, string> = {
  browse: "max-w-[280px]",
  messages: "max-w-[720px]",
  operations: "max-w-[720px]",
  monitoring: "max-w-[720px]",
  spotlight: "max-w-[480px]",
  mcp: "max-w-[480px]",
  themes: "max-w-[560px]",
};

// astro:assets reads intrinsic width/height from the imported files, so the
// slide never collapses while a PNG loads. `widths` stops at each file's
// display size × 2 (retina); sharp won't upscale past the original anyway.
const visuals: Record<string, { src: ImageMetadata; widths: number[]; sizes: string }> = {
  browse: { src: browseShot, widths: [280, 555], sizes: "(max-width: 360px) 85vw, 280px" },
  messages: { src: messagesShot, widths: [720, 1440], sizes: "(max-width: 800px) calc(100vw - 4rem), 720px" },
  operations: { src: operationsShot, widths: [720, 1440], sizes: "(max-width: 800px) calc(100vw - 4rem), 720px" },
  monitoring: { src: monitoringShot, widths: [720, 1347], sizes: "(max-width: 800px) calc(100vw - 4rem), 720px" },
  spotlight: { src: spotlightShot, widths: [480, 904], sizes: "(max-width: 540px) calc(100vw - 4rem), 480px" },
  themes: { src: themesShot, widths: [560, 1120], sizes: "(max-width: 620px) calc(100vw - 4rem), 560px" },
};
---
<section id="features" data-snap-to="features" class="max-w-6xl mx-auto px-6 py-24 md:py-32 scroll-mt-20">
  <h2 class="reveal text-3xl md:text-4xl font-bold mb-4 tracking-tight text-center">
    Built for the way developers actually use Service Bus.
  </h2>
  <p class="reveal text-[var(--color-muted)] mb-10 md:mb-12 max-w-2xl mx-auto text-center">
    Everything you'd want Service Bus Explorer to be, without the legacy baggage.
  </p>

  <div
    class="reveal ft-carousel relative"
    role="region"
    aria-roledescription="carousel"
    aria-label="viewbus features"
  >
    <!-- Track. Native scroll-snap handles swipe / trackpad scroll;
         buttons and dots drive the same scrollTo programmatically. -->
    <!-- aria-live starts off so autoplay doesn't narrate a slide change every
         6s; it flips to polite once the user drives the carousel themselves. -->
    <div class="ft-track" tabindex="0" aria-live="off">
      {features.map((f, i) => (
        <article
          class="ft-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${features.length}: ${f.title}`}
          data-index={i}
        >
          <div class={`grid items-center gap-10 ${f.wide ? "md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] md:gap-8 lg:gap-10 px-2 md:px-6 lg:px-8" : "md:grid-cols-2 md:gap-12 lg:gap-16 px-2 md:px-10 lg:px-16"}`}>
            <div class="md:max-w-md md:justify-self-end">
              {f.isNew && (
                <span
                  class="inline-flex items-center gap-1.5 mb-3 rounded-full bg-[var(--color-accent)] text-[var(--color-bg)] px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-[0.16em] shadow-sm"
                  aria-label="New feature"
                >
                  <span class="size-1.5 rounded-full bg-[var(--color-bg)]" aria-hidden="true"></span>
                  New
                </span>
              )}
              <h3 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">{f.title}</h3>
              <p class="text-[var(--color-muted)] leading-relaxed">{f.body}</p>
            </div>
            <div class="flex justify-center md:justify-start min-w-0">
              {f.id === "mcp" ? (
                <div class={`dark-card lifted w-full rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-bg)] overflow-hidden font-mono text-[11.5px] ${visualMaxWidth[f.id]}`}>
                  <div class="h-7 border-b border-[var(--color-border)] flex items-center px-3 gap-2 text-[10px] text-[var(--color-muted)]">
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="size-1.5 rounded-full bg-[var(--color-muted)]/50"></span>
                    <span class="ml-2">viewbus-mcp</span>
                  </div>
                  <div class="p-4 space-y-0.5 text-[var(--color-fg)]">
                    <div class="text-[var(--color-muted)]">$ viewbus-mcp --list-tools</div>
                    <div class="text-[var(--color-accent)]">10 read-only tools · 1 opt-in write tool</div>
                    <div class="h-2"></div>
                    {mcpTools.map((t) => (
                      <div class="flex gap-3">
                        <span class="text-[var(--color-success)] shrink-0">{t.name}</span>
                        <span class="text-[var(--color-muted)] truncate">{t.note}</span>
                      </div>
                    ))}
                    <div class="h-2"></div>
                    <div class="text-[var(--color-muted)]">
                      <span class="text-[var(--color-fg)]">upsert_theme</span>
                      <span class="ml-3">write · opt-in via settings</span>
                    </div>
                  </div>
                </div>
              ) : (
                <div class={`dark-card lifted w-full rounded-[var(--radius)] overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg)] ${visualMaxWidth[f.id]}`}>
                  <Image
                    src={visuals[f.id].src}
                    alt={f.title}
                    widths={visuals[f.id].widths}
                    sizes={visuals[f.id].sizes}
                    loading={i < 2 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                    class="block w-full h-auto"
                  />
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Prev / Next nav. Hidden on touch-only / narrow screens — swipe is faster. -->
    <button type="button" class="ft-nav ft-prev lifted-sm" aria-label="Previous feature" data-direction="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <button type="button" class="ft-nav ft-next lifted-sm" aria-label="Next feature" data-direction="1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>

    <!-- Dot indicators. Width grows on the active dot for a clear "you are here". -->
    <div class="ft-dots">
      <div class="flex items-center" role="tablist" aria-label="Choose feature slide">
        {features.map((f, i) => (
          <button
            type="button"
            role="tab"
            aria-label={f.title}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-dot
            data-index={i}
            class="ft-dot"
          ></button>
        ))}
      </div>
      <button type="button" class="ft-play" data-autoplay-toggle aria-label="Pause the feature carousel">
        <svg data-autoplay-pause width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" />
        </svg>
        <svg data-autoplay-play class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13a1 1 0 0 0 1.5.9l11-6.5a1 1 0 0 0 0-1.8l-11-6.5A1 1 0 0 0 8 5.5Z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const AUTOPLAY_MS = 6000;

    document.querySelectorAll(".ft-carousel").forEach((root) => {
      const track = root.querySelector(".ft-track");
      const slides = Array.from(root.querySelectorAll(".ft-slide"));
      const dots = Array.from(root.querySelectorAll("[data-dot]"));
      const prev = root.querySelector(".ft-prev");
      const next = root.querySelector(".ft-next");
      if (!track || slides.length === 0) return;

      const playBtn = root.querySelector("[data-autoplay-toggle]");
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let current = 0;
      let autoplayTimer = null;
      let inView = false;
      // Set once the user takes over (button, dot, swipe, or the explicit
      // pause control). Autoplay never resumes on its own after that.
      let stopped = prefersReduced;
      let scrollSettleTimer = null;

      // Nothing to pause when reduced motion already suppressed autoplay.
      if (prefersReduced && playBtn) playBtn.hidden = true;

      const updateDots = () => {
        dots.forEach((dot, i) => {
          dot.setAttribute("aria-selected", i === current ? "true" : "false");
          dot.setAttribute("tabindex", i === current ? "0" : "-1");
        });
      };

      const goTo = (index) => {
        const wrapped = ((index % slides.length) + slides.length) % slides.length;
        const target = slides[wrapped];
        // When the autoplay wraps from the last slide back to the first
        // (or someone clicks the prev button on slide 0), jump instantly
        // instead of animating the whole track backwards.
        const isLongJump = Math.abs(wrapped - current) > 1;
        track.scrollTo({
          left: target.offsetLeft - track.offsetLeft,
          behavior: isLongJump ? "auto" : "smooth",
        });
        current = wrapped;
        updateDots();
      };

      const startAutoplay = () => {
        if (stopped || autoplayTimer !== null) return;
        autoplayTimer = window.setInterval(() => {
          goTo(current + 1);
        }, AUTOPLAY_MS);
      };

      const stopAutoplay = () => {
        if (autoplayTimer !== null) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      };

      const sync = () => {
        if (inView && !stopped) startAutoplay();
        else stopAutoplay();
      };

      const syncPlayBtn = () => {
        if (!playBtn) return;
        playBtn.setAttribute(
          "aria-label",
          stopped ? "Play the feature carousel" : "Pause the feature carousel",
        );
        const pause = playBtn.querySelector("[data-autoplay-pause]");
        const play = playBtn.querySelector("[data-autoplay-play]");
        pause && pause.classList.toggle("hidden", stopped);
        play && play.classList.toggle("hidden", !stopped);
      };

      const markInteracted = () => {
        stopped = true;
        stopAutoplay();
        // Once the user is driving, slide changes are worth announcing.
        track.setAttribute("aria-live", "polite");
        syncPlayBtn();
      };

      if (playBtn) {
        playBtn.addEventListener("click", () => {
          stopped = !stopped;
          syncPlayBtn();
          sync();
        });
      }

      // Prev / Next buttons
      [prev, next].forEach((btn) => {
        if (!btn) return;
        btn.addEventListener("click", () => {
          markInteracted();
          const dir = parseInt(btn.getAttribute("data-direction") || "1", 10);
          goTo(current + dir);
        });
      });

      // Dots
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          markInteracted();
          goTo(i);
        });
        dot.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
            e.preventDefault();
            markInteracted();
            const delta = e.key === "ArrowRight" ? 1 : -1;
            goTo(current + delta);
            dots[current].focus();
          }
        });
      });

      // Track keyboard nav (focus the track, then arrow keys scroll panels)
      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          markInteracted();
          goTo(current + (e.key === "ArrowRight" ? 1 : -1));
        }
      });

      // Native scroll (swipe / trackpad) — sync index to whichever slide
      // ended up centered after the user finished scrolling.
      track.addEventListener("scroll", () => {
        if (scrollSettleTimer) clearTimeout(scrollSettleTimer);
        scrollSettleTimer = window.setTimeout(() => {
          const trackRect = track.getBoundingClientRect();
          const trackCenter = trackRect.left + trackRect.width / 2;
          let closest = current;
          let closestDist = Infinity;
          slides.forEach((s, i) => {
            const r = s.getBoundingClientRect();
            const slideCenter = r.left + r.width / 2;
            const dist = Math.abs(slideCenter - trackCenter);
            if (dist < closestDist) {
              closest = i;
              closestDist = dist;
            }
          });
          if (closest !== current) {
            current = closest;
            updateDots();
            // Treat manual swipe as user interaction.
            markInteracted();
          }
        }, 120);
      });

      // Hover pause (resume on leave, unless user has clicked / swiped)
      root.addEventListener("mouseenter", stopAutoplay);
      root.addEventListener("mouseleave", () => { if (!stopped) startAutoplay(); });

      // Pause when tab is hidden.
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopAutoplay();
        else sync();
      });

      if ("IntersectionObserver" in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) inView = entry.isIntersecting;
            sync();
          },
          { threshold: 0.1 }
        ).observe(root);
      } else {
        inView = true;
        sync();
      }

      updateDots();
      syncPlayBtn();
    });
  })();
</script>
