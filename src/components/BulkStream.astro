---
// A bulk resend as a particle stream: eight worker lanes carry dead letters
// back to their queue, Service Bus throttles halfway and the job backs off,
// then it finishes. Particles are drawn on a canvas (hundreds of dots stay
// cheap); the pills, chip and footer are HTML. Without JS the card shows the
// job's starting state.
const TOTAL = 1240;
---
<div class="fx-card dark-card" data-bulk data-total={TOTAL}>
  <div class="fx-card-head">
    <span class="font-mono text-[13px] truncate"><span class="text-[var(--color-muted)]">bulk resend ·</span> reason = <span class="text-[var(--fx-glow-fail)]">"PaymentDeclined"</span></span>
    <span class="shrink-0 font-mono text-[11px] text-[var(--color-muted)]">8 workers</span>
  </div>

  <div class="bs-stage" aria-hidden="true">
    <canvas class="bs-canvas"></canvas>
    <span class="bs-pill bs-from">
      <span class="bs-pill-label">orders-incoming</span>
      <span class="bs-pill-sub font-mono">$deadletterqueue</span>
      <span class="bs-pill-count font-mono is-dl" data-from>{TOTAL.toLocaleString("en-US")}</span>
    </span>
    <span class="bs-pill bs-to">
      <span class="bs-pill-label">orders-incoming</span>
      <span class="bs-pill-sub font-mono">active</span>
      <span class="bs-pill-count font-mono" data-to>12</span>
    </span>
    <span class="bs-chip font-mono" data-chip>throttled · backing off 2s</span>
  </div>

  <div class="bs-foot">
    <div class="bs-bar"><span data-bar></span></div>
    <div class="flex items-center justify-between gap-4 text-[13px]">
      <span class="font-mono tabular-nums text-[var(--color-fg)]" data-progress>0 / {TOTAL.toLocaleString("en-US")} resent</span>
      <span class="font-mono tabular-nums text-[var(--color-muted)]" data-rate>ready</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-bulk]").forEach((card) => {
      const TOTAL = Number(card.dataset.total);
      const LANES = 8;
      const stage = card.querySelector(".bs-stage");
      const canvas = card.querySelector(".bs-canvas");
      const ctx = canvas.getContext("2d");
      const fromEl = card.querySelector("[data-from]");
      const toEl = card.querySelector("[data-to]");
      const bar = card.querySelector("[data-bar]");
      const progressEl = card.querySelector("[data-progress]");
      const rateEl = card.querySelector("[data-rate]");
      const chip = card.querySelector("[data-chip]");
      const fmt = (n) => n.toLocaleString("en-US");

      let W = 0, H = 0, lanes = [];
      const layout = () => {
        const dpr = window.devicePixelRatio || 1;
        W = stage.clientWidth; H = stage.clientHeight;
        canvas.width = W * dpr; canvas.height = H * dpr;
        canvas.style.width = W + "px"; canvas.style.height = H + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const from = card.querySelector(".bs-from").getBoundingClientRect();
        const to = card.querySelector(".bs-to").getBoundingClientRect();
        const s = stage.getBoundingClientRect();
        const x0 = from.right - s.left, x3 = to.left - s.left, cy = H / 2;
        const span = x3 - x0;
        lanes = Array.from({ length: LANES }, (_, i) => {
          const k = i - (LANES - 1) / 2;
          return [
            [x0, cy + k * 2.5],
            [x0 + span * 0.3, cy + k * 21],
            [x3 - span * 0.3, cy + k * 21],
            [x3, cy + k * 2.5],
          ];
        });
      };
      const bez = (l, t) => {
        const u = 1 - t;
        const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
        return [a * l[0][0] + b * l[1][0] + c * l[2][0] + d * l[3][0], a * l[0][1] + b * l[1][1] + c * l[2][1] + d * l[3][1]];
      };

      let parts = [], done = 0, spawned = 0, last = 0, acc = 0, phase = "run", phaseAt = 0, throttled = false, raf = 0, running = false, inView = false, startedAt = 0;
      const RATE = 150;

      const reset = (now) => {
        parts = []; done = 0; spawned = 0; acc = 0; phase = "run"; phaseAt = now; throttled = false; startedAt = now;
        chip.classList.remove("is-on");
        card.classList.remove("is-done", "is-throttled");
        update(now);
      };

      const update = (now) => {
        fromEl.textContent = fmt(TOTAL - done);
        toEl.textContent = fmt(12 + done);
        bar.style.width = `${(done / TOTAL) * 100}%`;
        progressEl.textContent = phase === "done" ? `${fmt(TOTAL)} / ${fmt(TOTAL)} resent · 0 failed` : `${fmt(done)} / ${fmt(TOTAL)} resent`;
        const secs = (now - startedAt) / 1000;
        const rate = secs > 0.3 ? Math.round(done / secs) : 0;
        if (phase === "done") rateEl.textContent = "completed";
        else if (phase === "throttle") rateEl.textContent = "waiting on Service Bus";
        else rateEl.textContent = rate ? `${rate} msg/s · ETA ${Math.max(1, Math.ceil((TOTAL - done) / RATE))}s` : "starting…";
      };

      const draw = () => {
        ctx.clearRect(0, 0, W, H);
        ctx.lineWidth = 1;
        ctx.strokeStyle = phase === "throttle" ? "rgba(245,176,65,0.28)" : "rgba(255,255,255,0.08)";
        lanes.forEach((l) => {
          ctx.beginPath();
          ctx.moveTo(l[0][0], l[0][1]);
          ctx.bezierCurveTo(l[1][0], l[1][1], l[2][0], l[2][1], l[3][0], l[3][1]);
          ctx.stroke();
        });
        parts.forEach((p) => {
          const [x, y] = bez(lanes[p.lane], p.t);
          const fade = Math.min(1, p.t * 8, (1 - p.t) * 8);
          ctx.fillStyle = `rgba(190,242,100,${0.16 * fade})`;
          ctx.beginPath(); ctx.arc(x, y, 4.2, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = `rgba(214,255,140,${0.95 * fade})`;
          ctx.beginPath(); ctx.arc(x, y, 1.6, 0, Math.PI * 2); ctx.fill();
        });
      };

      const frame = (now) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;

        if (phase === "run") {
          acc += dt * RATE;
          while (acc >= 1 && spawned < TOTAL) {
            acc -= 1; spawned += 1;
            parts.push({ lane: Math.floor(Math.random() * LANES), t: 0, v: 1.1 + Math.random() * 0.5 });
          }
          if (!throttled && done >= TOTAL * 0.42) {
            throttled = true; phase = "throttle"; phaseAt = now;
            chip.classList.add("is-on"); card.classList.add("is-throttled");
          }
        } else if (phase === "throttle" && now - phaseAt > 2100) {
          phase = "run"; chip.classList.remove("is-on"); card.classList.remove("is-throttled");
        } else if (phase === "done" && now - phaseAt > 2600) {
          reset(now);
        }

        parts.forEach((p) => (p.t += p.v * dt));
        const before = parts.length;
        parts = parts.filter((p) => p.t < 1);
        done += before - parts.length;
        if (done >= TOTAL && phase === "run") { done = TOTAL; phase = "done"; phaseAt = now; card.classList.add("is-done"); }

        update(now);
        draw();
        raf = requestAnimationFrame(frame);
      };

      const play = () => {
        if (running || !inView || document.hidden) return;
        running = true; layout(); last = performance.now(); reset(last); raf = requestAnimationFrame(frame);
      };
      const stop = () => { running = false; cancelAnimationFrame(raf); };

      window.addEventListener("resize", () => running && layout());
      if ("IntersectionObserver" in window) {
        new IntersectionObserver((es) => es.forEach((e) => { inView = e.isIntersecting; inView ? play() : stop(); }), { threshold: 0.2 }).observe(card);
      } else { inView = true; play(); }
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
    });
  })();
</script>
