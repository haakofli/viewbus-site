---
export interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;

const sizes = {
  sm: "text-lg",
  md: "text-2xl",
  lg: "text-6xl md:text-7xl",
  xl: "text-7xl md:text-8xl",
};
---
<span class:list={["inline-flex items-baseline tracking-tight", sizes[size], className]} aria-label="ViewBus">
  <span class="font-normal text-[var(--color-muted)]">view</span><span class="font-bold text-[var(--color-fg)]">bus</span>
</span>
