---
import LogoMark from "./LogoMark.astro";

// How an alert actually travels: a rule matches, viewbus asks the user's own
// AI assistant a closed set of questions, then viewbus — not the AI — decides
// whether the alert goes out or is held. Cycles three real outcomes:
//   still rising → always sent · a clear "no" → held · unsure → sent anyway.
// Curves are a stretched SVG; pills, nodes and dots are HTML placed by %.
// Without JS the card shows the first scenario's finished state.
const SRC_X = 0, VB_X = 41, AI_X = 61, OUT_X = 76;
const ROW = 34;
const outs = [
  { id: "desktop", label: "Desktop", y: 12 },
  { id: "slack", label: "Slack", y: 34 },
  { id: "held", label: "Held", y: 58 },
];
const outPath = (y: number) => `M${AI_X + 4} ${ROW} C ${AI_X + 10} ${ROW}, ${OUT_X - 6} ${y}, ${OUT_X} ${y}`;
---
<div class="fx-card dark-card" data-review>
  <div class="fx-card-head">
    <span class="font-mono text-[13px]"><span class="text-[var(--color-muted)]">rule:</span> dead letters <span class="text-[var(--fx-glow-fail)]">&gt; 25</span></span>
    <span class="flex items-center gap-1.5 font-mono text-[11px] text-[var(--color-muted)]"><span class="rv-spark-mini" aria-hidden="true"></span>AI review · on</span>
  </div>

  <div class="rv-stage" aria-hidden="true">
    <svg class="fo-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path data-path="in" d={`M32 ${ROW} L${VB_X - 4} ${ROW}`} />
      <path data-path="ask" d={`M${VB_X + 4} ${ROW} L${AI_X - 4} ${ROW}`} />
      {outs.map((o) => <path data-path={o.id} class:list={[o.id === "held" && "rv-held-line"]} d={outPath(o.y)} />)}
    </svg>

    <span class="ar-pill ar-src rv-src"style={`left:${SRC_X};top:${ROW}%`} data-src>
      <svg class="ar-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" /></svg>
      <span class="truncate" data-src-name>orders-incoming</span>
      <span class="ar-count font-mono" data-src-count>30</span>
    </span>

    <span class="fo-node rv-vb" style={`left:${VB_X}%;top:${ROW}%`}><LogoMark variant="color" width={22} height={18} /></span>
    <span class="rv-node-label font-mono" style={`left:${VB_X}%;top:calc(${ROW}% + 32px)`}>rule matched</span>

    <span class="fo-node rv-ai" style={`left:${AI_X}%;top:${ROW}%`}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 14.06 12 20l2.06-5.94L20 12l-5.94-2.06L12 4l-2.06 5.94L4 12z" /><path d="M19 3v4M21 5h-4" /></svg>
    </span>
    <span class="rv-node-label font-mono" style={`left:${AI_X}%;top:calc(${ROW}% + 32px)`}>your AI</span>

    {outs.map((o) => (
      <span class:list={["ar-pill ar-ch rv-out", o.id === "held" && "rv-held"]} data-out={o.id} style={`left:${OUT_X}%;top:${o.y}%`}>
        {o.id === "desktop" && <svg class="ar-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>}
        {o.id === "slack" && <svg class="ar-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" /></svg>}
        {o.id === "held" && <svg class="ar-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16" rx="1" /><rect x="14" y="4" width="4" height="16" rx="1" /></svg>}
        <span class="truncate">{o.label}{o.sub && <span class="ar-sub"> {o.sub}</span>}</span>
        <span class="ar-sent">✓</span>
      </span>
    ))}

    <div class="rv-answers" data-answers>
      <div class="rv-q" data-q="cause"><span class="rv-k">cause</span><span class="rv-v" data-v="cause">PaymentDeclined · checkout-api</span><span class="rv-by">AI</span></div>
      <div class="rv-q" data-q="action"><span class="rv-k">action needed</span><span class="rv-v" data-v="action">yes</span><span class="rv-by">AI</span></div>
      <div class="rv-q" data-q="trend"><span class="rv-k">trend</span><span class="rv-v" data-v="trend">rising · +18 in 10 min</span><span class="rv-by">viewbus</span></div>
    </div>
  </div>

  <div class="fx-card-foot">
    <span class="ar-log is-fire flex min-w-0 items-center gap-2" data-log>
      <span class="ar-log-dot"></span>
      <span class="truncate" data-log-text>Sent · still rising, so it always reaches you</span>
    </span>
    <span class="rv-verdict font-mono is-send" data-verdict>notify</span>
  </div>
</div>

<script is:inline>
  (function () {
    const SCENARIOS = [
      {
        name: "orders-incoming", count: 30,
        cause: "PaymentDeclined · checkout-api", action: "yes", trend: "rising · +18 in 10 min",
        send: true, log: "Sent · still rising, so it always reaches you",
      },
      {
        name: "refunds", count: 27,
        cause: "test orders, postal 99999", action: "no", trend: "flat for 2 h",
        send: false, log: "Held · a clear “no” from your AI, and the count isn't moving",
      },
      {
        name: "email-sub", count: 41,
        cause: "SMTP timeouts, unclear why", action: "unsure", trend: "flat for 40 min",
        send: true, log: "Sent · your AI wasn't sure, so you decide",
      },
    ];

    document.querySelectorAll("[data-review]").forEach((card) => {
      const stage = card.querySelector(".rv-stage");
      const svg = card.querySelector(".fo-lines");
      const path = (n) => svg.querySelector(`[data-path="${n}"]`);
      const $ = (s) => card.querySelector(s);
      const srcPill = $("[data-src]"), srcName = $("[data-src-name]"), srcCount = $("[data-src-count]");
      const vb = $(".rv-vb"), ai = $(".rv-ai");
      const answers = $("[data-answers]");
      const qs = Array.from(card.querySelectorAll(".rv-q"));
      const log = $("[data-log]"), logText = $("[data-log-text]"), verdict = $("[data-verdict]");
      const out = (id) => $(`[data-out="${id}"]`);

      const pool = [];
      const dot = (i) => {
        while (pool.length <= i) {
          const d = document.createElement("span");
          d.className = "fo-dot";
          stage.appendChild(d);
          pool.push(d);
        }
        return pool[i];
      };
      const ease = (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
      const clamp = (t) => Math.max(0, Math.min(1, t));
      const place = (d, p, t) => {
        if (t <= 0 || t >= 1) { d.style.opacity = "0"; return; }
        const pt = p.getPointAtLength(p.getTotalLength() * ease(t));
        d.style.transform = `translate(${(pt.x / 100) * stage.clientWidth}px, ${(pt.y / 100) * stage.clientHeight}px)`;
        d.style.opacity = String(Math.min(1, t * 6, (1 - t) * 6));
      };
      const flash = (el, cls) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };

      const LEN = 8.2;
      let fired = {}, idx = -1, start = 0, raf = 0, running = false, inView = false;
      const once = (k, fn) => { if (!fired[k]) { fired[k] = true; fn(); } };

      const setup = (s) => {
        srcName.textContent = s.name;
        srcCount.textContent = "0";
        srcPill.classList.remove("is-hot");
        answers.classList.remove("is-on");
        qs.forEach((q) => q.classList.remove("is-shown"));
        card.querySelector('[data-v="cause"]').textContent = s.cause;
        card.querySelector('[data-v="action"]').textContent = s.action;
        card.querySelector('[data-v="action"]').className = `rv-v is-${s.action}`;
        card.querySelector('[data-v="trend"]').textContent = s.trend;
        card.querySelector('[data-v="trend"]').className = `rv-v ${s.trend.startsWith("rising") ? "is-yes" : ""}`;
        card.querySelectorAll(".rv-out").forEach((o) => o.classList.remove("is-sent"));
        ai.classList.remove("is-thinking");
        verdict.className = "rv-verdict font-mono";
        verdict.textContent = "";
        log.className = "ar-log flex min-w-0 items-center gap-2";
        logText.textContent = `${s.name} · ${s.count} dead letters`;
      };

      const frame = (now) => {
        const el = (now - start) / 1000;
        const n = Math.floor(el / LEN);
        const t = el % LEN;
        const s = SCENARIOS[n % SCENARIOS.length];
        if (n !== idx) { idx = n; fired = {}; setup(s); }

        const c = Math.round(Math.min(1, t / 0.8) * s.count);
        srcCount.textContent = String(c);
        if (c > 25) once("hot", () => srcPill.classList.add("is-hot"));

        place(dot(0), path("in"), clamp((t - 0.7) / 0.6));
        dot(0).className = "fo-dot is-fail";
        if (t > 1.3) once("match", () => flash(vb, "is-fire"));
        place(dot(1), path("ask"), clamp((t - 1.35) / 0.6));
        dot(1).className = "fo-dot is-fail";
        if (t > 1.95) once("ask", () => { ai.classList.add("is-thinking"); answers.classList.add("is-on"); });
        [2.3, 2.85, 3.4].forEach((at, i) => { if (t > at) once(`q${i}`, () => qs[i].classList.add("is-shown")); });
        if (t > 3.9) once("verdict", () => {
          ai.classList.remove("is-thinking");
          verdict.textContent = s.send ? "notify" : "hold";
          verdict.className = `rv-verdict font-mono ${s.send ? "is-send" : "is-hold"}`;
        });

        const targets = s.send ? ["desktop", "slack"] : ["held"];
        targets.forEach((id, i) => {
          const d = dot(2 + i);
          d.className = `fo-dot ${s.send ? "is-alert" : "is-check"}`;
          place(d, path(id), clamp((t - 4.1 - i * 0.12) / 0.9));
          if (t > 5.05 + i * 0.12) once(`arrive-${id}`, () => {
            out(id).classList.add("is-sent");
            flash(out(id), "is-hit");
            log.className = `ar-log flex min-w-0 items-center gap-2 ${s.send ? "is-fire" : "is-held"}`;
            logText.textContent = s.log;
          });
        });
        if (s.send) dot(4).style.opacity = "0";
        else dot(3).style.opacity = "0";

        raf = requestAnimationFrame(frame);
      };

      card.classList.add("is-js");
      const play = () => {
        if (running || !inView || document.hidden) return;
        running = true; start = performance.now(); idx = -1; raf = requestAnimationFrame(frame);
      };
      const stop = () => { running = false; cancelAnimationFrame(raf); pool.forEach((d) => (d.style.opacity = "0")); };

      if ("IntersectionObserver" in window) {
        new IntersectionObserver((es) => es.forEach((e) => { inView = e.isIntersecting; inView ? play() : stop(); }), { threshold: 0.2 }).observe(card);
      } else { inView = true; play(); }
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
    });
  })();
</script>
