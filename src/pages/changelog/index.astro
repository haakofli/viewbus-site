---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("changelog")).sort(
  (a, b) =>
    b.data.publishedAt.localeCompare(a.data.publishedAt) ||
    b.data.version.localeCompare(a.data.version, undefined, { numeric: true }),
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const title = "Changelog — viewbus";
const description = "Every viewbus release, with what changed and why.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://viewbus.app/" },
    { "@type": "ListItem", "position": 2, "name": "Changelog", "item": "https://viewbus.app/changelog" }
  ]
};
---
<Base title={title} description={description} path="/changelog">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <article class="max-w-3xl mx-auto px-6 py-20 prose">
    <h1 class="text-4xl font-bold tracking-tight mb-4">Changelog</h1>
    <p class="text-[var(--color-muted)] mb-12">
      Latest: <a href={`/changelog/${entries[0]?.data.version}/`} class="underline">v{entries[0]?.data.version}</a>
      <span class="mx-2 select-none">·</span>
      <a href="/rss.xml" class="underline">RSS feed</a>
    </p>

    {rendered.map(({ entry, Content }, i) => (
      <details class="changelog-entry not-prose mb-3 border-b border-[var(--color-border)] last:border-0" open={i === 0}>
        <summary class="changelog-summary flex items-baseline gap-3 py-4 cursor-pointer select-none list-none">
          <svg
            class="changelog-chevron shrink-0 self-center text-[var(--color-muted)] transition-transform"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <span class="text-lg font-semibold tracking-tight tabular-nums">v{entry.data.version}</span>
          <time class="text-sm text-[var(--color-muted)] tabular-nums" datetime={entry.data.publishedAt}>{entry.data.publishedAt}</time>
          <span class="changelog-teaser hidden sm:block ml-auto text-sm text-[var(--color-muted)] truncate">{entry.data.summary}</span>
        </summary>
        <div class="changelog-body prose pb-8 pt-1">
          <Content />
          <p class="mt-6 mb-0 flex flex-wrap gap-x-6 gap-y-1">
            <a
              class="text-[var(--color-accent)] hover:underline"
              href={`https://github.com/haakofli/viewbus-site/releases/tag/v${entry.data.version}`}
            >
              Download v{entry.data.version} →
            </a>
            <a
              class="text-[var(--color-accent)] hover:underline"
              href={`/changelog/${entry.data.version}/`}
            >
              Permalink
            </a>
          </p>
        </div>
      </details>
    ))}
  </article>
</Base>

<style>
  /* Hide native disclosure marker — we render our own chevron. */
  .changelog-summary::-webkit-details-marker { display: none; }
  .changelog-summary::marker { content: ""; }

  /* Rotate chevron when entry is open. */
  details[open] > .changelog-summary .changelog-chevron {
    transform: rotate(90deg);
  }

  /* Hover affordance on the summary row. */
  .changelog-summary:hover .changelog-chevron,
  .changelog-summary:focus-visible .changelog-chevron {
    color: var(--color-fg);
  }

  /* Hide the redundant `## X.Y.Z — date` heading the markdown body carries —
     the summary already shows the version + date, so re-rendering it inside
     would be visual noise. Targets only top-level h2s; section headers (h3+)
     for Features / Improvements / Fixes still render normally. The h2 comes
     from rendered markdown, which carries no scope attribute — hence :global. */
  .changelog-body > :global(h2) { display: none; }

  /* Drop the teaser if it would collide with the version + date in tight
     viewports — sm:block above already gates it. */
  .changelog-summary .changelog-teaser {
    max-width: 22rem;
  }
</style>
