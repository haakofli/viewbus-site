---
import Base from "../layouts/Base.astro";

const features = [
  {
    title: "Fast tree browsing",
    body: "Subscriptions, namespaces, queues, topics, and subscriptions — all indexed locally in SQLite. Navigation is instant even on enterprise tenants with thousands of resources.",
  },
  {
    title: "Peek without dequeuing",
    body: "Read active and dead-letter messages without removing them. Filter by session, message ID, correlation ID, subject, or DL reason — combine filters to narrow down a noisy queue fast. Bodies render as JSON, XML, or plain text.",
  },
  {
    title: "Resend & delete",
    body: "Requeue dead-lettered messages with edited properties. Delete stuck messages. Bulk operations with confirmation, so you don't nuke a queue by accident.",
  },
  {
    title: "Manual connections",
    body: "Paste any Service Bus connection string to reach namespaces outside your Azure account. Legacy endpoints, external tenants, shared dev buses — all first-class citizens.",
  },
  {
    title: "Spotlight search",
    body: "Ctrl+I (configurable) opens a system-wide fuzzy search across every indexed resource. Close ViewBus to the tray and Spotlight still works — open anything from anywhere.",
  },
  {
    title: "Built-in MCP server",
    body: "Ships a Model Context Protocol server with 10 read-only tools so Claude, ChatGPT, or any MCP-aware AI can list namespaces, search resources, count messages, peek queues, and fetch full message details. One opt-in write tool lets the AI author themes if you enable it.",
  },
  {
    title: "Themes & VS Code import",
    body: "Dark and light modes plus custom user themes. One-click importer pulls your active VS Code theme into ViewBus.",
  },
  {
    title: "Everything local, always",
    body: "No telemetry, no phone-home, no backend. Credentials stay on your machine. Connection strings live in the OS credential manager, never in plain text on disk.",
  },
];

const title = "ViewBus — Azure Service Bus desktop manager";
const description = "A fast, local, private desktop app for managing Azure Service Bus. Peek messages, resend dead letters, and search your entire bus from one keyboard-driven interface. Free for Windows.";
---
<Base title={title} description={description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ViewBus",
      "description": description,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Windows 10, Windows 11",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "url": "https://viewbus.app",
      "downloadUrl": "https://github.com/haakofli/viewbus-site/releases/latest",
      "softwareVersion": "0.1.0",
      "author": {
        "@type": "Person",
        "name": "Håkon Lia"
      }
    })} />
  </Fragment>

  <section class="max-w-6xl mx-auto px-6 pt-20 pb-16 text-center">
    <p class="text-sm uppercase tracking-widest text-[var(--color-accent)] mb-6">Azure Service Bus, made fast</p>
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6">
      The Service Bus client<br />you actually want to open.
    </h1>
    <p class="text-xl text-[var(--color-muted)] max-w-2xl mx-auto mb-10">
      Browse, peek, resend, and search across every queue and topic — all from a native Windows app that keeps your data on your machine.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="#download" class="bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-black font-medium px-6 py-3 rounded-lg transition-colors">
        Download for Windows
      </a>
      <a href="#features" class="border border-[var(--color-border)] hover:border-[var(--color-fg)] px-6 py-3 rounded-lg transition-colors">
        See features
      </a>
    </div>
    <p class="mt-6 text-sm text-[var(--color-muted)]">Free · No account · No telemetry</p>

    <div class="mt-16 aspect-[16/10] bg-[var(--color-border)]/40 border border-[var(--color-border)] rounded-xl overflow-hidden flex items-center justify-center text-[var(--color-muted)]">
      <span>Hero screenshot (1920×1200)</span>
    </div>
  </section>

  <section id="features" class="max-w-6xl mx-auto px-6 py-20 scroll-mt-20">
    <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Built for the way developers actually use Service Bus.</h2>
    <p class="text-[var(--color-muted)] mb-12 max-w-2xl">Everything you'd want Service Bus Explorer to be, without the legacy baggage.</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <article class="border border-[var(--color-border)] rounded-xl p-6 hover:border-[var(--color-accent)] transition-colors">
          <h3 class="font-semibold text-lg mb-2">{f.title}</h3>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed">{f.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="border border-[var(--color-border)] rounded-xl p-10 md:p-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Your data stays on your machine.</h2>
      <p class="text-[var(--color-muted)] max-w-2xl mx-auto leading-relaxed">
        ViewBus has no backend servers, sends no telemetry, and has no account system. Your Azure credentials are used directly by your machine to talk to Azure. Connection strings live in the Windows Credential Manager, never on disk in plain text.
      </p>
      <a href="/privacy" class="inline-block mt-6 text-[var(--color-accent)] hover:underline">Read the full privacy promise →</a>
    </div>
  </section>

  <section id="download" class="max-w-6xl mx-auto px-6 py-20 scroll-mt-20">
    <div class="text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Download ViewBus</h2>
      <p class="text-[var(--color-muted)] mb-10">Windows 10 and 11. Free. No sign-up.</p>
      <a href="https://github.com/haakofli/viewbus-site/releases/latest" class="bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-black font-medium px-8 py-4 rounded-lg inline-block transition-colors">
        Latest release on GitHub
      </a>
      <p class="mt-6 text-sm text-[var(--color-muted)]">
        Or grab a specific version from the <a href="/changelog" class="underline hover:text-[var(--color-fg)]">changelog</a>.
      </p>
    </div>
  </section>
</Base>
