---
import Base from "../layouts/Base.astro";
import FeatureTabs from "../components/FeatureTabs.astro";
import { latest } from "../lib/latest";

const title = "viewbus — A modern Service Bus Explorer alternative";
const description = "A fast, local, private desktop app for managing Azure Service Bus. Peek messages, resend dead letters, and search your entire bus from one keyboard-driven interface. Ships a built-in Model Context Protocol (MCP) server so AI assistants can list namespaces, search resources, and peek messages. Free for Windows and macOS.";

const windowsInstaller = latest.platforms["windows-x86_64"].url;
const macInstaller = latest.platforms["darwin-aarch64"].url;

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "viewbus",
  "alternateName": "ViewBus",
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "Azure Tools",
  "operatingSystem": "Windows 10, Windows 11, macOS",
  "processorRequirements": "x64, arm64",
  "softwareRequirements": "Windows 10 (x64) / Windows 11, or macOS on Apple Silicon",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "url": "https://viewbus.app",
  "downloadUrl": latest.installerUrl,
  "installUrl": "https://viewbus.app/latest.json",
  "releaseNotes": "https://viewbus.app/changelog",
  "screenshot": "https://viewbus.app/og.png",
  "softwareVersion": latest.version,
  "datePublished": latest.publishedAt.slice(0, 10),
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "license": "Proprietary (closed source, free of charge)",
  "sameAs": [
    "https://github.com/haakofli/viewbus-site"
  ],
  "author": {
    "@type": "Person",
    "name": "Håkon Lia",
    "url": "https://viewbus.app"
  },
  "publisher": {
    "@type": "Person",
    "name": "Håkon Lia"
  },
  "featureList": [
    "Browse Azure subscriptions and Service Bus namespaces in a local, SQLite-backed tree",
    "Multi-tenant Azure sign-in — switch between tenants from the account dialog; sidebar, search, and MCP results stay scoped to the active tenant",
    "Peek active and dead-letter queue and topic messages without dequeuing",
    "Filter messages by session ID, message ID, correlation ID, subject, or dead-letter reason",
    "Edit message body and properties in an inline Monaco diff editor before resending",
    "Compose and schedule brand-new messages with full property and content-type control",
    "Bulk operations: purge an active queue, dead-letter every active message, or empty an entire dead-letter queue with progress and cancel",
    "Spotlight fuzzy search (Ctrl+I, rebindable) across every indexed resource, system-wide",
    "Close-to-tray with Spotlight search still active",
    "Manual Azure Service Bus connection strings, stored in the OS keychain (Windows Credential Manager / macOS Keychain) — never on disk in plain text",
    "Built-in Model Context Protocol (MCP) server over stdio transport for AI assistants (Claude, ChatGPT, Cursor)",
    "MCP tool: get_status — index state, selected subscription, last refresh, resource count",
    "MCP tool: list_namespaces — enumerate indexed Azure Service Bus namespaces",
    "MCP tool: list_queues — list queues in a namespace",
    "MCP tool: list_topics — list topics in a namespace",
    "MCP tool: list_subscriptions — list subscriptions under a topic",
    "MCP tool: get_resource — full detail for a single indexed resource by ID",
    "MCP tool: search_resources — fuzzy search across queues, topics, and subscriptions",
    "MCP tool: count_messages — active and dead-letter counts for a queue or subscription",
    "MCP tool: peek_messages — read messages without dequeuing",
    "MCP tool: get_message_detail — full message body and properties by sequence number",
    "MCP tool: upsert_theme (opt-in) — let an AI author ViewBus themes",
    "Dark, light, and custom user themes; one-click VS Code theme import",
    "No telemetry, no backend servers, no accounts — everything runs locally"
  ],
  "keywords": "Azure Service Bus, Service Bus Explorer alternative, dead letter queue, DLQ, message peek, resend dead letter, MCP server, Model Context Protocol, Windows desktop, Azure developer tool, queue management, topic subscription"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://viewbus.app/"
    }
  ]
};
---
<Base title={title} description={description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 pt-12 md:pt-20 pb-16 md:pb-24 text-center">
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tight leading-[0.95] text-[var(--color-fg)]">
        The local-first<br />Service Bus explorer
      </h1>

      <p class="mt-6 max-w-2xl mx-auto text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        Built in Rust. Stays on your machine. Ships an MCP server so AI assistants can peek queues for you.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <!-- Mac: secondary, glassy pill — opens unsigned-app notice modal -->
        <button
          type="button"
          data-download
          data-mac-download
          data-mac-installer={macInstaller}
          class="lifted-sm inline-flex items-center gap-2.5 whitespace-nowrap bg-[var(--color-chrome)] hover:bg-[color-mix(in_oklab,var(--color-chrome)_88%,var(--color-fg))] border border-[var(--color-border)] rounded-full h-11 px-5 text-sm font-medium text-[var(--color-fg)] cursor-pointer transition-[background-color,box-shadow] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Download for macOS
        </button>

        <!-- Windows: primary, inverted fill — direct download -->
        <a
          href={windowsInstaller}
          data-download
          class="lifted-sm inline-flex items-center gap-2.5 whitespace-nowrap bg-[var(--color-fg)] text-[var(--color-bg)] hover:bg-[color-mix(in_oklab,var(--color-fg)_88%,transparent)] rounded-full h-11 px-6 text-sm font-medium transition-[background-color,box-shadow] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="0" y="0" width="10" height="10" />
            <rect x="12" y="0" width="10" height="10" />
            <rect x="0" y="12" width="10" height="10" />
            <rect x="12" y="12" width="10" height="10" />
          </svg>
          Download for Windows
        </a>
      </div>

      <p class="mt-5 font-mono text-[11px] text-[var(--color-muted)] tracking-wide">
        v{latest.version}
      </p>

      <div class="lifted-xl mt-14 md:mt-20 max-w-5xl mx-auto rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-border)] bg-[oklch(0.18_0.01_260)]">
        <img
          src="/screenshots/viewbus-main.png"
          alt="viewbus app showing the orders-incoming dead-letter queue with a selected message and JSON body preview"
          width="2101"
          height="1369"
          loading="eager"
          decoding="async"
          class="block w-full h-auto"
        />
      </div>
    </div>
  </section>

  <FeatureTabs />

  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Your data stays on your machine.</h2>
      <p class="text-[var(--color-muted)] leading-relaxed">
        viewbus has no backend servers, sends no telemetry, and has no account system. Your Azure credentials are used directly by your machine to talk to Azure. Connection strings live in the OS keychain — Windows Credential Manager on Windows, macOS Keychain on Mac — never on disk in plain text.
      </p>
      <a href="/privacy" class="inline-block mt-6 text-[var(--color-accent)] hover:underline">Read the full privacy promise →</a>
    </div>
  </section>

  <dialog
    id="mac-download-dialog"
    aria-labelledby="mac-download-title"
    class="m-auto max-w-xl w-[calc(100%-2rem)] rounded-2xl border border-[var(--color-border)] bg-[var(--color-chrome)] text-[var(--color-fg)] p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  >
    <form method="dialog" class="flex flex-col gap-5 p-7 text-left">
      <div class="flex items-start gap-3">
        <svg width="20" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--color-fg)] mt-0.5 shrink-0" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <h2 id="mac-download-title" class="text-lg font-semibold leading-snug">
          Heads up — macOS build isn't notarized yet
        </h2>
      </div>

      <div class="text-sm leading-relaxed text-[var(--color-muted)] space-y-4">
        <p>
          viewbus for macOS isn't notarized by Apple yet, so on first launch macOS will say it's damaged or can't be verified. You'll need to clear the quarantine flag once. Pick whichever feels easier:
        </p>

        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-fg)]/[0.03] p-4 space-y-2">
          <p class="font-medium text-[var(--color-fg)]">Option A — Terminal (one command)</p>
          <ol class="list-decimal pl-5 space-y-1.5">
            <li>Open the DMG and drag <span class="text-[var(--color-fg)]">ViewBus.app</span> into <span class="text-[var(--color-fg)]">/Applications</span> (don't run it from inside the DMG — quarantine re-applies).</li>
            <li>Open <span class="text-[var(--color-fg)]">Terminal</span> and run:
              <pre class="mt-2 px-3 py-2 rounded-md bg-[var(--color-bg)]/60 border border-[var(--color-border)] text-[12px] text-[var(--color-fg)] overflow-x-auto"><code>xattr -cr /Applications/ViewBus.app</code></pre>
            </li>
            <li>Launch from Launchpad or <span class="text-[var(--color-fg)]">/Applications</span>.</li>
          </ol>
        </div>

        <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-fg)]/[0.03] p-4 space-y-2">
          <p class="font-medium text-[var(--color-fg)]">Option B — System Settings (no Terminal)</p>
          <ol class="list-decimal pl-5 space-y-1.5">
            <li>Open the DMG and drag <span class="text-[var(--color-fg)]">ViewBus.app</span> into <span class="text-[var(--color-fg)]">/Applications</span>.</li>
            <li>Try to open it — macOS will block it. Dismiss the warning.</li>
            <li>Open <span class="text-[var(--color-fg)]">System Settings → Privacy &amp; Security</span>, scroll down, and click <span class="text-[var(--color-fg)]">Open Anyway</span> next to viewbus.</li>
            <li>Confirm in the dialog that follows.</li>
          </ol>
        </div>

        <p>You only need to do this once per install.</p>
      </div>

      <p class="text-sm text-[var(--color-fg)]">Do you still want to download?</p>

      <div class="flex justify-end gap-2 pt-1">
        <button
          type="button"
          data-mac-cancel
          class="inline-flex items-center justify-center rounded-full h-10 px-5 text-sm font-medium border border-[var(--color-border)] bg-transparent hover:bg-[var(--color-hover)] cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          Cancel
        </button>
        <button
          type="button"
          data-mac-confirm
          class="inline-flex items-center justify-center rounded-full h-10 px-5 text-sm font-medium bg-[var(--color-fg)] text-[var(--color-bg)] hover:bg-[var(--color-fg)]/90 cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-chrome)]"
        >
          Yes, download
        </button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    (() => {
      const dialog = document.getElementById("mac-download-dialog");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const triggers = document.querySelectorAll("[data-mac-download]");
      const cancelBtn = dialog.querySelector("[data-mac-cancel]");
      const confirmBtn = dialog.querySelector("[data-mac-confirm]");
      let pendingUrl = "";

      triggers.forEach((btn) => {
        btn.addEventListener("click", (event) => {
          event.preventDefault();
          pendingUrl = btn.getAttribute("data-mac-installer") || "";
          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          } else if (pendingUrl) {
            window.location.href = pendingUrl;
          }
        });
      });

      cancelBtn?.addEventListener("click", () => dialog.close());

      confirmBtn?.addEventListener("click", () => {
        dialog.close();
        if (pendingUrl) window.location.href = pendingUrl;
      });

      // Click outside the form (on the backdrop) closes the dialog.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    })();
  </script>

</Base>
