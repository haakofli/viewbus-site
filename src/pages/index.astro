  <script is:inline>
    (() => {
      const dlg = document.getElementById("win-download-dialog");
      const triggers = document.querySelectorAll("[data-win-download]");
      // No Store dialog (storeUrl empty) → the trigger's href downloads the .exe directly.
      if (!(dlg instanceof HTMLDialogElement)) return;

      triggers.forEach((el) => {
        el.addEventListener("click", (event) => {
          // No <dialog> support → let the link fall through to the .exe download.
          if (typeof dlg.showModal !== "function") return;
          event.preventDefault();
          dlg.showModal();
        });
      });

      dlg.querySelector("[data-win-close]")?.addEventListener("click", () => dlg.close());
      dlg.querySelector("[data-win-confirm]")?.addEventListener("click", () => {
        const url = dlg.dataset.installer || "";
        dlg.close();
        if (url) window.location.href = url;
      });
      dlg.addEventListener("click", (event) => {
        if (event.target === dlg) dlg.close();
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const brewDialog = document.getElementById("mac-brew-dialog");
      const dmgDialog = document.getElementById("mac-download-dialog");
      if (!(brewDialog instanceof HTMLDialogElement)) return;

      const hasDmgDialog = dmgDialog instanceof HTMLDialogElement;
      const triggers = document.querySelectorAll("[data-mac-download]");
      const brewCmd = "brew install --cask haakofli/viewbus/viewbus";

      let dmgPendingUrl = "";

      function openDmgModal(url) {
        if (!hasDmgDialog) {
          if (url) window.location.href = url;
          return;
        }
        dmgPendingUrl = url;
        if (typeof dmgDialog.showModal === "function") {
          dmgDialog.showModal();
        } else if (url) {
          window.location.href = url;
        }
      }

      // Trigger → open brew modal (primary path)
      triggers.forEach((btn) => {
        btn.addEventListener("click", (event) => {
          event.preventDefault();
          const installer = btn.getAttribute("data-mac-installer") || "";
          brewDialog.dataset.macInstaller = installer;
          if (typeof brewDialog.showModal === "function") {
            brewDialog.showModal();
          } else if (installer) {
            window.location.href = installer;
          }
        });
      });

      // Brew modal: copy logic
      const copyLabelEl = brewDialog.querySelector("[data-brew-copy-label]");

      async function copyBrewCommand() {
        try {
          await navigator.clipboard.writeText(brewCmd);
          if (copyLabelEl) {
            const original = copyLabelEl.textContent;
            copyLabelEl.textContent = "Copied!";
            setTimeout(() => { copyLabelEl.textContent = original; }, 1500);
          }
        } catch (e) {
          // Clipboard unavailable — select the command so the user can copy manually.
          const code = brewDialog.querySelector("[data-brew-cmd]");
          const sel = window.getSelection && window.getSelection();
          if (code && sel) {
            const range = document.createRange();
            range.selectNode(code);
            sel.removeAllRanges();
            sel.addRange(range);
          }
        }
      }

      brewDialog.querySelector("[data-brew-copy]")?.addEventListener("click", copyBrewCommand);
      brewDialog.querySelector("[data-brew-inline-copy]")?.addEventListener("click", copyBrewCommand);
      brewDialog.querySelector("[data-brew-cancel]")?.addEventListener("click", () => brewDialog.close());
      brewDialog.querySelector("[data-brew-close]")?.addEventListener("click", () => brewDialog.close());

      // Brew modal: "No Homebrew?" → close brew, open DMG fallback
      brewDialog.querySelector("[data-brew-to-dmg]")?.addEventListener("click", () => {
        const installer = brewDialog.dataset.macInstaller || "";
        brewDialog.close();
        openDmgModal(installer);
      });

      brewDialog.addEventListener("click", (event) => {
        if (event.target === brewDialog) brewDialog.close();
      });

      // DMG fallback modal handlers
      if (hasDmgDialog) {
        dmgDialog.querySelector("[data-mac-cancel]")?.addEventListener("click", () => dmgDialog.close());
        dmgDialog.querySelector("[data-mac-confirm]")?.addEventListener("click", () => {
          dmgDialog.close();
          if (dmgPendingUrl) window.location.href = dmgPendingUrl;
        });
        dmgDialog.addEventListener("click", (event) => {
          if (event.target === dmgDialog) dmgDialog.close();
        });
      }
    })();
  </script>

  <script is:inline>
    // Handheld: copy the download URL so the visitor can pick it up on a machine
    // that can actually run viewbus.
    (() => {
      document.querySelectorAll("[data-copy-link]").forEach((btn) => {
        const label = btn.querySelector("[data-copy-label]");
        btn.addEventListener("click", async () => {
          const value = btn.getAttribute("data-copy-value") || location.href;
          const done = (text) => {
            if (!label) return;
            const was = label.textContent;
            label.textContent = text;
            setTimeout(() => { label.textContent = was; }, 1800);
          };
          try {
            await navigator.clipboard.writeText(value);
            done("Copied — open it on your desktop");
          } catch {
            // No clipboard permission (or insecure context): share sheet, else nothing.
            if (navigator.share) {
              try { await navigator.share({ url: value, title: "viewbus" }); } catch {}
            } else {
              done(value);
            }
          }
        });
      });
    })();
  </script>

  <script is:inline>
    // Promote the download button that matches the visitor's OS. The SSR
    // default keeps Windows emphasized + first; on macOS we swap the emphasis
    // and order so Mac visitors — our cross-platform differentiator — get the
    // primary CTA instead of the secondary one.
    (() => {
      // iPhone reports "iPhone" and iPadOS reports "MacIntel", so without this
      // guard every iOS visitor gets pointed at a Homebrew command.
      if (document.documentElement.classList.contains("handheld")) return;
      const platform =
        (navigator.userAgentData && navigator.userAgentData.platform) ||
        navigator.platform ||
        navigator.userAgent ||
        "";
      if (!/mac/i.test(platform)) return;
      const mac = document.querySelector('[data-os="mac"]');
      const win = document.querySelector('[data-os="win"]');
      if (!mac || !win) return;
      mac.classList.replace("dl-soft", "dl-emph");
      win.classList.replace("dl-emph", "dl-soft");
      mac.style.order = "0";
      win.style.order = "1";
    })();
  </script>

  <style>
    /* Download CTA color treatments. Sizing/layout/focus stay as inline utility
       classes; only the fill-vs-outline emphasis lives here so the OS-detect
       script can swap a single class between the two buttons. */
    .dl-emph { background: var(--color-fg); color: var(--color-bg); }
    .dl-emph:hover { background: color-mix(in oklab, var(--color-fg) 88%, transparent); }
    .dl-soft {
      background: var(--color-chrome);
      color: var(--color-fg);
      border: 1px solid var(--color-border);
    }
    .dl-soft:hover { background: color-mix(in oklab, var(--color-chrome) 88%, var(--color-fg)); }

    /* Hide the native scrollbar on the brew command — the Copy button is the
       primary affordance, and Windows' default scrollbar arrows look terrible
       inside a small inline pill. Users can still scroll/select the text. */
    .brew-cmd { scrollbar-width: none; }
    .brew-cmd::-webkit-scrollbar { display: none; }
  </style>

</Base>
