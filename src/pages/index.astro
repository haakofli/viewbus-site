---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import AppWindow from "../components/AppWindow.astro";
import FeatureTabs from "../components/FeatureTabs.astro";

const title = "viewbus — Azure Service Bus desktop manager";
const description = "A fast, local, private desktop app for managing Azure Service Bus. Peek messages, resend dead letters, and search your entire bus from one keyboard-driven interface. Ships a built-in Model Context Protocol (MCP) server so AI assistants can list namespaces, search resources, and peek messages. Free for Windows.";

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "viewbus",
  "alternateName": "ViewBus",
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "Azure Tools",
  "operatingSystem": "Windows 10, Windows 11",
  "processorRequirements": "x64",
  "softwareRequirements": "Windows 10 (x64) or Windows 11",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "url": "https://viewbus.app",
  "downloadUrl": "https://github.com/haakofli/viewbus-site/releases/latest/download/ViewBus_0.1.0_x64-setup.exe",
  "installUrl": "https://viewbus.app/latest.json",
  "releaseNotes": "https://viewbus.app/changelog",
  "screenshot": "https://viewbus.app/og.png",
  "softwareVersion": "0.1.0",
  "datePublished": "2026-04-22",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "license": "Proprietary (closed source, free of charge)",
  "sameAs": [
    "https://github.com/haakofli/viewbus-site"
  ],
  "author": {
    "@type": "Person",
    "name": "Håkon Lia",
    "url": "https://viewbus.app"
  },
  "publisher": {
    "@type": "Person",
    "name": "Håkon Lia"
  },
  "featureList": [
    "Browse Azure subscriptions and Service Bus namespaces in a local, SQLite-backed tree",
    "Peek active and dead-letter queue and topic messages without dequeuing",
    "Filter messages by session ID, message ID, correlation ID, subject, or dead-letter reason",
    "Resend dead-lettered messages (optionally with property edits) or bulk-delete stuck messages",
    "Spotlight fuzzy search (Ctrl+I, rebindable) across every indexed resource, system-wide",
    "Close-to-tray with Spotlight search still active",
    "Manual Azure Service Bus connection strings, stored in Windows Credential Manager (never on disk in plain text)",
    "Built-in Model Context Protocol (MCP) server over stdio transport for AI assistants (Claude, ChatGPT, Cursor)",
    "MCP tool: get_status — index state, selected subscription, last refresh, resource count",
    "MCP tool: list_namespaces — enumerate indexed Azure Service Bus namespaces",
    "MCP tool: list_queues — list queues in a namespace",
    "MCP tool: list_topics — list topics in a namespace",
    "MCP tool: list_subscriptions — list subscriptions under a topic",
    "MCP tool: get_resource — full detail for a single indexed resource by ID",
    "MCP tool: search_resources — fuzzy search across queues, topics, and subscriptions",
    "MCP tool: count_messages — active and dead-letter counts for a queue or subscription",
    "MCP tool: peek_messages — read messages without dequeuing",
    "MCP tool: get_message_detail — full message body and properties by sequence number",
    "MCP tool: upsert_theme (opt-in) — let an AI author ViewBus themes",
    "Dark, light, and custom user themes; one-click VS Code theme import",
    "No telemetry, no backend servers, no accounts — everything runs locally"
  ],
  "keywords": "Azure Service Bus, Service Bus Explorer alternative, dead letter queue, DLQ, message peek, resend dead letter, MCP server, Model Context Protocol, Windows desktop, Azure developer tool, queue management, topic subscription"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://viewbus.app/"
    }
  ]
};
---
<Base title={title} description={description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <AppWindow>
    <!-- Welcome-screen layout: flex flex-col items-center gap-6 text-center -->
    <div class="flex flex-col items-center gap-6 text-center">
      <h1 class="tracking-tight leading-none">
        <Wordmark size="welcome" />
        <span class="sr-only">
          viewbus — Azure Service Bus desktop manager for Windows with a built-in Model Context Protocol (MCP) server
        </span>
      </h1>

      <p class="max-w-md text-sm text-[var(--color-muted)] leading-relaxed">
        A modern app for working with Azure Service Bus, with a companion MCP server.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-3">
        <!-- Mac: disabled, glassy pill -->
        <button
          type="button"
          disabled
          aria-disabled="true"
          title="Coming soon"
          data-download
          class="inline-flex items-center gap-2.5 whitespace-nowrap backdrop-blur-md bg-[var(--color-fg)]/[0.04] border border-[var(--color-border)] rounded-full h-11 pl-5 pr-2 text-sm cursor-not-allowed"
        >
          <svg width="15" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--color-muted)]" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <span class="font-medium text-[var(--color-muted)]">Download</span>
          <span class="ml-1 inline-flex items-center px-2.5 py-1 rounded-full bg-[var(--color-fg)]/[0.06] text-[10px] uppercase tracking-[0.1em] font-mono text-[var(--color-muted-dim)]">
            soon
          </span>
        </button>

        <!-- Windows: primary, inverted fill -->
        <a
          href="https://github.com/haakofli/viewbus-site/releases/latest"
          data-download
          class="inline-flex items-center gap-2.5 whitespace-nowrap bg-[var(--color-fg)] text-[var(--color-bg)] hover:bg-[var(--color-fg)]/90 rounded-full h-11 px-6 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="0" y="0" width="10" height="10" />
            <rect x="12" y="0" width="10" height="10" />
            <rect x="0" y="12" width="10" height="10" />
            <rect x="12" y="12" width="10" height="10" />
          </svg>
          Download for Windows
        </a>
      </div>

      <p class="font-mono text-[11px] text-[var(--color-muted)] tracking-wide">
        v0.1.0
      </p>
    </div>
  </AppWindow>

  <FeatureTabs />

  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Your data stays on your machine.</h2>
      <p class="text-[var(--color-muted)] leading-relaxed">
        viewbus has no backend servers, sends no telemetry, and has no account system. Your Azure credentials are used directly by your machine to talk to Azure. Connection strings live in the Windows Credential Manager, never on disk in plain text.
      </p>
      <a href="/privacy" class="inline-block mt-6 text-[var(--color-accent)] hover:underline">Read the full privacy promise →</a>
    </div>
  </section>

</Base>
