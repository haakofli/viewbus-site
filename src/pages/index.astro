---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import FeatureTabs from "../components/FeatureTabs.astro";
import Faq from "../components/Faq.astro";
import { latest } from "../lib/latest";
import heroShot from "../assets/screenshots/viewbus-main.png";

const title = "viewbus — A modern Service Bus Explorer alternative";
// Kept under ~160 chars so Google shows it whole. The long-form pitch lives in
// `longDescription` and only feeds the JSON-LD.
const description =
  "A fast, local desktop app for Azure Service Bus. Peek and resend dead letters, search every queue at once, and hand it to your AI. Free for Windows and macOS.";
const longDescription =
  "A fast, local, private desktop app for managing Azure Service Bus. Peek messages, resend dead letters, and search your entire bus from one keyboard-driven interface. Ships a built-in Model Context Protocol (MCP) server so AI assistants can list namespaces, search resources, and peek messages. Free for Windows and macOS.";

const windowsInstaller = latest.platforms["windows-x86_64"]?.url ?? latest.installerUrl;
const macInstaller = latest.platforms["darwin-aarch64"]?.url ?? null;

// Microsoft Store listing — the trusted Windows path (Microsoft re-signs the
// package, so no SmartScreen warning, and it auto-updates via the Store). Stable
// across releases, so it lives here, NOT in latest.json (which the release
// workflow regenerates). Set to "" to fall back to the direct .exe download.
const storeUrl = "https://apps.microsoft.com/detail/9p0q5zmlv15k";

// Most-requested features — open issues in THIS repo labeled `feature-request`,
// ranked by 👍 reactions. Fetched at build time only: the page stays static, no
// runtime calls, no per-visitor GitHub hits. A scheduled rebuild refreshes the
// counts. Any failure (offline / rate-limit / no label yet) falls back to an
// empty list and the "be the first" prompt.
interface FeatureRequest { title: string; url: string; votes: number; body: string; }

// Issue bodies are raw markdown written against the feature-request template.
// Rendering them verbatim leaks `**bold**` markers and the template's own
// prompts ("What would you like viewbus to do?") straight onto the page.
const TEMPLATE_PROMPTS = [
  /what would you like viewbus to do\??/i,
  /why is it useful\??/i,
  /describe the (?:feature|solution|alternative)[^.?!]*[.?!]?/i,
  /additional context/i,
  /is your feature request related to a problem\??/i,
];

function toPlainText(markdown: string): string {
  let text = (markdown ?? "")
    .replace(/```[\s\S]*?```/g, " ")            // fenced code
    .replace(/<!--[\s\S]*?-->/g, " ")           // HTML comments
    .replace(/<[^>]+>/g, " ")                   // stray HTML
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")      // images
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")    // links -> label
    .replace(/^\s{0,3}#{1,6}\s+/gm, "")         // headings
    .replace(/^\s{0,3}>\s?/gm, "")              // blockquotes
    .replace(/^\s{0,3}[-*+]\s+/gm, "")          // bullets
    .replace(/^\s{0,3}\d+\.\s+/gm, "")          // ordered lists
    .replace(/\*\*([^*]+)\*\*/g, "$1")          // bold
    .replace(/__([^_]+)__/g, "$1")
    .replace(/(^|[\s(])[*_]([^*_\n]+)[*_](?=[\s).,!?]|$)/g, "$1$2") // italics
    .replace(/`([^`]+)`/g, "$1")                // inline code
    .replace(/^\s*[-*_]{3,}\s*$/gm, " ");       // rules

  for (const prompt of TEMPLATE_PROMPTS) text = text.replace(prompt, " ");

  return text.replace(/\s+/g, " ").trim();
}

let featureRequests: FeatureRequest[] = [];
try {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 5000);
  const query = "repo:haakofli/viewbus-site is:issue is:open label:feature-request";
  const res = await fetch(
    `https://api.github.com/search/issues?q=${encodeURIComponent(query)}&sort=reactions-%2B1&order=desc&per_page=5`,
    {
      headers: { "User-Agent": "viewbus-site", Accept: "application/vnd.github+json" },
      signal: ctrl.signal,
    },
  );
  clearTimeout(timer);
  if (res.ok) {
    const data = await res.json();
    featureRequests = (data.items ?? []).map((i: any) => {
      const body = toPlainText(i.body as string);
      return {
        title: i.title as string,
        url: i.html_url as string,
        votes: (i.reactions?.["+1"] as number) ?? 0,
        // Anything shorter than this is template residue, not a description.
        body: body.length < 25 ? "" : body.slice(0, 120),
      };
    });
  }
} catch {
  featureRequests = [];
}
const featureRequestNewUrl =
  "https://github.com/haakofli/viewbus-site/issues/new?template=feature_request.md";

const comparison: {
  feature: string;
  viewbus: true | false | string;
  sbe: true | false | string;
  portal: true | false | string;
}[] = [
  { feature: "Native app for Mac & Windows", viewbus: true, sbe: "Windows only", portal: "In-browser" },
  { feature: "Search message bodies across queues, topics & subscriptions", viewbus: true, sbe: false, portal: false },
  { feature: "Edit & resend, with a side-by-side diff", viewbus: true, sbe: "Limited", portal: false },
  { feature: "Alerts when a queue or subscription crosses a threshold", viewbus: true, sbe: false, portal: false },
  { feature: "AI assistant access (MCP server)", viewbus: true, sbe: false, portal: false },
  { feature: "Relay, Event Hubs & Notification Hubs", viewbus: false, sbe: true, portal: false },
  { feature: "Price", viewbus: "Free", sbe: "Free", portal: "Free" },
];

const faqs = [
  {
    q: "Is viewbus free?",
    a: "Yes — viewbus is free for both Windows and macOS, with no account, no trial, and no paid tier. If it saves you time you can buy me a coffee, but nothing in the app is gated.",
  },
  {
    q: "Does viewbus run on macOS?",
    a: "Yes. There's a native build for Apple Silicon, installable with `brew install --cask haakofli/viewbus/viewbus`. The original Service Bus Explorer is Windows-only.",
  },
  {
    q: "Can viewbus resend dead-lettered messages?",
    a: "Yes. Peek a dead-lettered message, edit its body and properties in a side-by-side diff editor, then resend it to the original entity — one at a time, or in bulk across a filtered batch.",
  },
  {
    q: "Does viewbus send my messages anywhere?",
    a: "No. There is no backend, no telemetry, and no account. Your machine talks directly to Microsoft: login.microsoftonline.com, management.azure.com, and your own *.servicebus.windows.net endpoints. The only requests to viewbus.app are two static JSON files the app reads at startup, one for updates and one for notices.",
  },
  {
    q: "Can I use viewbus with Claude, ChatGPT, or Cursor?",
    a: "Yes. viewbus ships a Model Context Protocol server over local stdio with ten read-only tools, so an AI assistant can list namespaces, search resources, count messages, and peek bodies without any cloud round-trip.",
  },
  {
    q: "Do I need an Azure connection string?",
    a: "No — signing in with your Azure account indexes every namespace you can see. Connection strings are still supported for namespaces outside your tenant, and they're stored in the OS keychain rather than on disk.",
  },
];

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "viewbus",
  "alternateName": "ViewBus",
  "description": longDescription,
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "Azure Tools",
  "operatingSystem": "Windows 10, Windows 11, macOS",
  "processorRequirements": "x64, arm64",
  "softwareRequirements": "Windows 10 (x64) / Windows 11, or macOS on Apple Silicon",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "url": "https://viewbus.app/",
  "downloadUrl": "https://viewbus.app/download/",
  "installUrl": "https://viewbus.app/latest.json",
  "releaseNotes": "https://viewbus.app/changelog/",
  "screenshot": "https://viewbus.app/og.png",
  "softwareVersion": latest.version,
  "datePublished": latest.publishedAt.slice(0, 10),
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "license": "https://viewbus.app/terms/",
  "sameAs": [
    "https://github.com/haakofli/viewbus-site"
  ],
  "author": {
    "@type": "Person",
    "name": "Håkon Lia",
    "url": "https://viewbus.app/"
  },
  "publisher": {
    "@type": "Person",
    "name": "Håkon Lia"
  },
  "featureList": [
    "Browse Azure subscriptions and Service Bus namespaces in a local, SQLite-backed tree",
    "Multi-tenant Azure sign-in — switch between tenants from the account dialog; sidebar, search, and MCP results stay scoped to the active tenant",
    "Peek active and dead-letter queue and topic messages without dequeuing",
    "Filter messages by session ID, message ID, correlation ID, subject, or dead-letter reason",
    "Edit message body and properties in an inline Monaco diff editor before resending",
    "Compose and schedule brand-new messages with full property and content-type control",
    "Bulk operations: purge an active queue, dead-letter every active message, or empty an entire dead-letter queue with progress and cancel",
    "Spotlight fuzzy search (Ctrl+I, rebindable) across every indexed resource, system-wide",
    "Close-to-tray with Spotlight search still active",
    "Manual Azure Service Bus connection strings, stored in the OS keychain (Windows Credential Manager / macOS Keychain) — never on disk in plain text",
    "Built-in Model Context Protocol (MCP) server over stdio transport for AI assistants (Claude, ChatGPT, Cursor)",
    "Local HTTP API on 127.0.0.1 for launcher plugins, editor tasks, and scripts",
    "MCP tool: get_status — index state, selected subscription, last refresh, resource count",
    "MCP tool: list_namespaces — enumerate indexed Azure Service Bus namespaces",
    "MCP tool: list_queues — list queues in a namespace",
    "MCP tool: list_topics — list topics in a namespace",
    "MCP tool: list_subscriptions — list subscriptions under a topic",
    "MCP tool: get_resource — full detail for a single indexed resource by ID",
    "MCP tool: search_resources — fuzzy search across queues, topics, and subscriptions",
    "MCP tool: count_messages — active and dead-letter counts for a queue or subscription",
    "MCP tool: peek_messages — read messages without dequeuing",
    "MCP tool: get_message_detail — full message body and properties by sequence number",
    "MCP tool: upsert_theme (opt-in) — let an AI author viewbus themes",
    "Dark, light, and custom user themes; one-click VS Code theme import",
    "No telemetry, no backend servers, no accounts — everything runs locally"
  ],
  "keywords": "Azure Service Bus, Service Bus Explorer alternative, dead letter queue, DLQ, message peek, resend dead letter, MCP server, Model Context Protocol, Windows desktop, Azure developer tool, queue management, topic subscription"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "viewbus",
  "url": "https://viewbus.app/",
  "inLanguage": "en",
  "publisher": { "@type": "Person", "name": "Håkon Lia" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/`/g, "") },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://viewbus.app/"
    }
  ]
};

const yes = "M20 6 9 17l-5-5";
---
<Base title={title} description={description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 pt-12 md:pt-20 pb-16 md:pb-24 text-center">
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tight leading-[0.95] text-[var(--color-fg)]">
        The fastest way to debug your Azure Service&nbsp;Buses
      </h1>

      <p class="mt-6 max-w-2xl mx-auto text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
        Search, inspect, edit, and resend messages in seconds — with custom dead-letter alerts and MCP-powered debugging built in.
      </p>

      <div data-desktop-only class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <!-- Windows: opens the Store-vs-direct modal via JS. Without JS the href
             still downloads the .exe directly. Emphasis (filled) is the default;
             the OS-detect script promotes the visitor's platform. -->
        <a
          href={windowsInstaller}
          data-download
          data-win-download
          data-os="win"
          class="dl-btn dl-emph lifted-sm inline-flex items-center gap-2.5 whitespace-nowrap rounded-full h-11 px-6 text-sm font-medium transition-[background-color,box-shadow] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="0" y="0" width="10" height="10" />
            <rect x="12" y="0" width="10" height="10" />
            <rect x="0" y="12" width="10" height="10" />
            <rect x="12" y="12" width="10" height="10" />
          </svg>
          Download for Windows
        </a>

        <!-- macOS: opens the Install-via-Homebrew modal. -->
        <button
          type="button"
          data-download
          data-mac-download
          data-os="mac"
          data-mac-installer={macInstaller}
          class="dl-btn dl-soft lifted-sm inline-flex items-center gap-2.5 whitespace-nowrap rounded-full h-11 px-6 text-sm font-medium cursor-pointer transition-[background-color,box-shadow] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Install for macOS
        </button>
      </div>

      <!-- Handheld: nothing here can be installed on a phone, so the job is to
           get the visitor back to this page on a real machine. -->
      <div data-handheld-only class="mt-10 flex flex-col items-center justify-center gap-3">
        <button
          type="button"
          data-copy-link
          data-copy-value="https://viewbus.app/download/"
          class="lifted-sm inline-flex items-center gap-2.5 whitespace-nowrap rounded-full h-12 px-6 text-sm font-medium bg-[var(--color-fg)] text-[var(--color-bg)] cursor-pointer transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span data-copy-label>Copy link for your desktop</span>
        </button>
        <a
          href="#features"
          class="inline-flex items-center gap-2 whitespace-nowrap rounded-full h-12 px-6 text-sm font-medium border border-[var(--color-border)] text-[var(--color-fg)] transition-colors hover:bg-[var(--color-hover)]"
        >
          See what it does
        </a>
      </div>

      <p data-desktop-only class="mt-5 font-mono text-[11px] text-[var(--color-muted)] tracking-wide">
        Free · v{latest.version} · no account, no telemetry
      </p>
      <p data-handheld-only class="mt-5 font-mono text-[11px] text-[var(--color-muted)] tracking-wide">
        Desktop app · Windows &amp; macOS · free, v{latest.version}
      </p>

      <div class="lifted-xl mt-14 md:mt-20 max-w-5xl mx-auto rounded-[var(--radius)] overflow-hidden border border-[var(--color-border)] bg-[oklch(0.18_0.01_260)]">
        <Image
          src={heroShot}
          alt="viewbus app showing the orders-incoming dead-letter queue with a selected message and its JSON body and properties"
          widths={[768, 1024, 1536, 2048]}
          sizes="(max-width: 1088px) calc(100vw - 3rem), 1024px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block w-full h-auto"
        />
      </div>
    </div>
  </section>

  <FeatureTabs />

  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <h2 class="reveal text-3xl md:text-4xl font-bold mb-4 tracking-tight text-center">
      How it compares
    </h2>
    <p class="reveal text-[var(--color-muted)] mb-10 md:mb-12 max-w-2xl mx-auto text-center leading-relaxed">
      The classic <span class="text-[var(--color-fg)]">Service Bus Explorer</span> is Windows-only; the Azure Portal can't search across resources or alert you. Here's where viewbus fits — and where the others still win.
    </p>

    <!-- Wide: a real comparison table. -->
    <div class="reveal hidden sm:block overflow-x-auto -mx-6 px-6">
      <table class="w-full min-w-[34rem] border-collapse text-sm">
        <caption class="sr-only">Feature comparison of viewbus, Service Bus Explorer, and the Azure Portal</caption>
        <thead>
          <tr class="border-b border-[var(--color-border)]">
            <th scope="col" class="py-3 pr-4 text-left"></th>
            <th scope="col" class="py-3 px-4 text-center text-base font-semibold text-[var(--color-fg)] bg-[color-mix(in_oklab,var(--color-accent)_8%,transparent)] rounded-t-[var(--radius)]">viewbus</th>
            <th scope="col" class="py-3 px-4 text-center font-medium text-[var(--color-muted)] leading-tight">Service Bus<br />Explorer</th>
            <th scope="col" class="py-3 px-4 text-center font-medium text-[var(--color-muted)]">Azure Portal</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map((row, i) => (
            <tr class={i < comparison.length - 1 ? "border-b border-[var(--color-border)]" : ""}>
              <th scope="row" class="py-3.5 pr-4 text-left font-normal text-[var(--color-fg)]">{row.feature}</th>
              {([row.viewbus, row.sbe, row.portal] as (true | false | string)[]).map((value, col) => (
                <td
                  class:list={[
                    "py-3.5 px-4 text-center",
                    col === 0 && "bg-[color-mix(in_oklab,var(--color-accent)_8%,transparent)]",
                    col === 0 && i === comparison.length - 1 && "rounded-b-[var(--radius)] font-medium text-[var(--color-fg)]",
                    typeof value === "string" && col > 0 && "text-xs text-[var(--color-muted)]",
                    value === false && "text-[var(--color-muted-dim)]",
                  ]}
                  aria-label={value === false ? "No" : undefined}
                >
                  {value === true ? (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--color-success)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="inline-block" role="img" aria-label="Yes"><path d={yes} /></svg>
                  ) : value === false ? "—" : value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Narrow: a table this wide would hide the two columns you're comparing
         against, so each row unrolls into a labelled list. Kept borderless —
         nesting tinted boxes inside cards reads as clutter at this width. -->
    <ul class="reveal sm:hidden border-t border-[var(--color-border)]">
      {comparison.map((row) => (
        <li class="border-b border-[var(--color-border)] py-5">
          <p class="font-medium leading-snug text-[var(--color-fg)]">{row.feature}</p>
          <dl class="mt-3 flex flex-col gap-2 text-sm">
            {[
              { label: "viewbus", value: row.viewbus, own: true },
              { label: "Service Bus Explorer", value: row.sbe, own: false },
              { label: "Azure Portal", value: row.portal, own: false },
            ].map(({ label, value, own }) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class:list={[own ? "font-medium text-[var(--color-fg)]" : "text-[var(--color-muted)]"]}>{label}</dt>
                <dd class:list={["shrink-0 text-right", value === false && "text-[var(--color-muted-dim)]"]}>
                  {value === true ? (
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-success)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="inline-block translate-y-0.5" role="img" aria-label="Yes"><path d={yes} /></svg>
                  ) : value === false ? <span aria-label="No">—</span> : <span class={own ? "font-medium text-[var(--color-fg)]" : "text-[var(--color-muted)]"}>{value}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>

    <p class="reveal mt-10 flex flex-col items-center justify-center gap-x-8 gap-y-2 text-center text-sm sm:flex-row">
      <a href="/why-viewbus/" class="text-[var(--color-accent)] hover:underline">
        Why viewbus works this way →
      </a>
      <a href="/service-bus-explorer-alternative/" class="text-[var(--color-accent)] hover:underline">
        Coming from Service Bus Explorer? →
      </a>
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <h2 class="reveal text-3xl md:text-4xl font-bold mb-4 tracking-tight text-center">
      On the roadmap
    </h2>
    <p class="reveal text-[var(--color-muted)] mb-10 md:mb-12 max-w-2xl mx-auto text-center leading-relaxed">
      Free, and shipping often. A few things already in the works:
    </p>
    <ul class="reveal grid gap-x-10 gap-y-10 sm:grid-cols-2">
      <li>
        <h3 class="font-semibold mb-1.5">Dead-letter trends</h3>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed">History and sparklines per resource, so you can spot a backlog that started building two days ago — not just right now.</p>
      </li>
      <li>
        <h3 class="font-semibold mb-1.5">More message formats</h3>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed">Syntax-highlighted XML, YAML, and protobuf bodies — not just JSON and plain text.</p>
      </li>
      <li>
        <h3 class="font-semibold mb-1.5">Local emulator support</h3>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed">Point viewbus at the local Azure Service Bus emulator for development, right beside your real namespaces.</p>
      </li>
      <li>
        <h3 class="font-semibold mb-1.5">Theme marketplace</h3>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed">Browse and one-click-install community-made viewbus themes, share your own, and export your full setup to move between machines.</p>
      </li>
    </ul>

    <div class="reveal mt-14">
      <div class="flex items-center justify-between gap-4 mb-4">
        <h3 class="text-lg font-semibold">Most requested</h3>
        <a
          href={featureRequestNewUrl}
          target="_blank"
          rel="noopener"
