---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import { Code } from "astro:components";

const title = "Azure Service Bus MCP server — viewbus";
const description =
  "viewbus ships a Model Context Protocol server so Claude, Cursor, or Codex can search your queues, count dead letters, and read message bodies — locally, read-only.";
const path = "/mcp-server";
const CODE = "github-dark";

// The binary path differs per install, so the app generates the real snippet
// for you (Settings → MCP). These show the shape each client expects.
const clients = [
  {
    id: "claude-desktop",
    label: "Claude Desktop",
    lang: "json",
    file: "claude_desktop_config.json",
    code: `{
  "mcpServers": {
    "viewbus": {
      "command": "<path to viewbus-mcp>"
    }
  }
}`,
  },
  {
    id: "claude-code",
    label: "Claude Code",
    lang: "json",
    file: ".mcp.json",
    code: `{
  "mcpServers": {
    "viewbus": {
      "command": "<path to viewbus-mcp>"
    }
  }
}`,
  },
  {
    id: "cursor",
    label: "Cursor",
    lang: "json",
    file: ".cursor/mcp.json",
    code: `{
  "mcpServers": {
    "viewbus": {
      "command": "<path to viewbus-mcp>"
    }
  }
}`,
  },
  {
    id: "codex",
    label: "Codex",
    lang: "toml",
    file: "config.toml",
    code: `[mcp_servers.viewbus]
command = "<path to viewbus-mcp>"`,
  },
  {
    id: "vscode-copilot",
    label: "VS Code Copilot",
    lang: "json",
    file: "mcp.json",
    code: `{
  "servers": {
    "viewbus": {
      "type": "stdio",
      "command": "<path to viewbus-mcp>"
    }
  }
}`,
  },
  {
    id: "opencode",
    label: "opencode",
    lang: "json",
    file: "opencode.json",
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "viewbus": {
      "type": "local",
      "command": ["<path to viewbus-mcp>"],
      "enabled": true
    }
  }
}`,
  },
];

const indexTools = [
  ["get_status", "Index state, selected subscription, last refresh, and whether live queries are available. Call it first."],
  ["list_namespaces", "Every indexed namespace in the selected subscription."],
  ["list_queues", "Queues under a namespace."],
  ["list_topics", "Topics under a namespace."],
  ["list_subscriptions", "Subscriptions under a topic."],
  ["get_resource", "Full detail for one indexed resource by ID."],
  ["search_resources", "Fuzzy search by name or path across queues, topics, and subscriptions."],
];

const liveTools = [
  ["count_messages", "How many messages match a filter — counts only, no bodies. Supports a breakdown by dead-letter reason."],
  ["peek_messages", "Message summaries (sequence number, subject, IDs, delivery count, short body preview). Capped at 100 per call."],
  ["get_message_detail", "The full body and all properties for one sequence number."],
];

const questions = [
  "How many dead letters piled up on the orders topic between 11:00 and 15:00?",
  "Break those down by dead-letter reason.",
  "Find any queue related to refunds.",
  "Show me the five most recent MaxDeliveryCount failures and what they have in common.",
  "What's in message 18473?",
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://viewbus.app/" },
    { "@type": "ListItem", position: 2, name: "MCP server", item: "https://viewbus.app/mcp-server/" },
  ],
};

const faqs = [
  {
    q: "Is there an MCP server for Azure Service Bus?",
    a: "Yes. viewbus, a free desktop app for Windows and macOS, ships a Model Context Protocol server over local stdio. It gives an AI assistant ten read-only tools for browsing namespaces, searching resources, counting messages, and peeking dead-letter bodies.",
  },
  {
    q: "Can the viewbus MCP server delete or send messages?",
    a: "No. Every message tool is read-only — there is no send, delete, resend, or purge tool. The only opt-in write tool writes theme files to disk, and it is off by default.",
  },
  {
    q: "How is this different from Microsoft's Azure MCP Server?",
    a: "Microsoft's server exposes Service Bus metadata such as counts and status. The viewbus MCP server can also peek actual message bodies, filter by dead-letter reason, and trace a message across resources, because it reuses the local index and the credentials the desktop app already holds.",
  },
  {
    q: "Does the MCP server send my messages to the cloud?",
    a: "Only to the AI client you configured it in. The server itself runs on your machine over stdio, reads a local SQLite index, and proxies live message queries through the running desktop app over a local socket. It opens no network listener.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<Base title={title} description={description} path={path}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="max-w-3xl mx-auto px-6 py-16 md:py-20">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-[1.05]">
      An MCP server for Azure Service&nbsp;Bus
    </h1>
    <p class="mt-5 text-lg text-[var(--color-muted)] leading-relaxed">
      viewbus ships a Model Context Protocol server, so Claude, Cursor, Codex, or any MCP-aware
      assistant can search your queues, count dead letters, and read message bodies — without you
      pasting anything into a chat window.
    </p>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
      It's read-only, it runs entirely on your machine, and it needs no credentials of its own. It
      comes with the app: <a href="/download/" class="text-[var(--color-accent)] hover:underline">install viewbus</a>
      and it's already there.
    </p>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">Setting it up</h2>
      <ol class="mt-5 flex flex-col gap-6">
        <li class="grid grid-cols-[1.6rem_1fr] gap-x-3.5 gap-y-1">
          <span class="mcp-step">1</span>
          <h3 class="self-center font-semibold">Run viewbus once and pick a subscription</h3>
          <div class="col-start-2 text-[var(--color-muted)] leading-relaxed">
            <p>
              The MCP server reads the index the desktop app builds, so it needs the app to have run
              at least once. Every tool except <code class="ic">get_status</code> is scoped to the
              subscription selected in the app — the same scoping the sidebar uses.
            </p>
          </div>
        </li>
        <li class="grid grid-cols-[1.6rem_1fr] gap-x-3.5 gap-y-1">
          <span class="mcp-step">2</span>
          <h3 class="self-center font-semibold">Copy the config from Settings → MCP</h3>
          <div class="col-start-2 text-[var(--color-muted)] leading-relaxed">
            <p>
              viewbus knows where its own <code class="ic">viewbus-mcp</code> binary landed, so it
              generates the snippet for you. Pick your client, hit copy, and paste it into that
              client's config file. The shapes look like this:
            </p>
          </div>
        </li>
        <li class="grid grid-cols-[1.6rem_1fr] gap-x-3.5 gap-y-1">
          <span class="mcp-step">3</span>
          <h3 class="self-center font-semibold">Restart the client</h3>
          <div class="col-start-2 text-[var(--color-muted)] leading-relaxed">
            <p>
              The tools show up automatically. In Claude Code, <code class="ic">/mcp</code> confirms
              <code class="ic">viewbus</code> is connected. Ask it "what's in my viewbus index?" to
              check the wiring.
            </p>
          </div>
        </li>
      </ol>

      <figure class="cb mt-8" data-mcp-tabs>
        <figcaption class="cb-bar">
          <div class="ct-tabs" role="tablist" aria-label="MCP client">
            {clients.map((c, i) => (
              <button
                type="button"
                role="tab"
                data-client={c.id}
                id={`mcp-tab-${c.id}`}
                aria-controls={`mcp-panel-${c.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="ct-tab"
              >{c.label}</button>
            ))}
          </div>
          <button type="button" class="cb-copy" data-mcp-copy aria-label="Copy config">Copy</button>
        </figcaption>
        {clients.map((c, i) => (
          <div
            class="ct-panel"
            data-client={c.id}
            id={`mcp-panel-${c.id}`}
            role="tabpanel"
            aria-labelledby={`mcp-tab-${c.id}`}
            hidden={i !== 0}
          >
            <Code code={c.code} lang={c.lang} theme={CODE} />
          </div>
        ))}
      </figure>
      <p class="mt-2.5 text-xs text-[var(--color-muted)]">
        Replace <code class="ic">&lt;path to viewbus-mcp&gt;</code> with the real path — or skip the
        guesswork and copy the filled-in version from Settings → MCP in the app.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">What the AI can do</h2>
      <p class="mt-3 text-[var(--color-muted)] leading-relaxed">
        Ten tools, all read-only. The first group reads the local index and works even with the app
        closed; the second queries live messages and needs the app running.
      </p>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)]">Index &amp; search</h3>
      <dl class="mt-3">
        {indexTools.map(([name, note]) => (
          <div class="flex flex-col gap-1 border-b border-[var(--color-border)] py-3 sm:flex-row sm:gap-5">
            <dt class="w-52 shrink-0"><code class="ic">{name}</code></dt>
            <dd class="text-sm text-[var(--color-muted)] leading-relaxed">{note}</dd>
          </div>
        ))}
      </dl>

      <h3 class="mt-8 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-muted)]">Live messages</h3>
      <dl class="mt-3">
        {liveTools.map(([name, note]) => (
          <div class="flex flex-col gap-1 border-b border-[var(--color-border)] py-3 sm:flex-row sm:gap-5">
            <dt class="w-52 shrink-0"><code class="ic">{name}</code></dt>
            <dd class="text-sm text-[var(--color-muted)] leading-relaxed">{note}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-sm text-[var(--color-muted)] leading-relaxed">
        Filters run inside viewbus, not in the model's context: body-contains, enqueued-time range,
        session, message ID, correlation ID, subject, dead-letter reason, and custom properties. That
        keeps message bytes out of the conversation unless you actually ask for a body.
      </p>
      <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed">
        There is one write tool, <code class="ic">upsert_theme</code>, which lets an assistant author
        viewbus themes. It's off unless you enable it in settings.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">Things worth asking it</h2>
      <ul class="mt-4 flex flex-col gap-2.5">
        {questions.map((q) => (
          <li class="rounded-[var(--radius)] border border-[var(--color-border)] px-4 py-3 text-sm leading-relaxed text-[var(--color-muted)]">
            <span class="mr-1.5 select-none text-[var(--color-accent)]">&rsaquo;</span>{q}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">What it can't do</h2>
      <p class="mt-3 text-[var(--color-muted)] leading-relaxed">
        Handing an AI assistant access to production queues is a real decision, so the boundaries are
        deliberately narrow:
      </p>
      <ul class="mt-4 flex flex-col gap-3 list-disc pl-6 leading-relaxed text-[var(--color-muted)] marker:text-[var(--color-muted)]">
        <li>
          <span class="text-[var(--color-fg)]">No writes to your bus.</span> There is no send, resend,
          delete, dead-letter, or purge tool. A peek is non-destructive and doesn't touch delivery counts.
        </li>
        <li>
          <span class="text-[var(--color-fg)]">No new credentials.</span> The server never talks to
          Azure itself. It reads the local SQLite index, and live queries go through the running
          desktop app using the sign-in you already have.
        </li>
        <li>
          <span class="text-[var(--color-fg)]">No network listener.</span> stdio to the client, a local
          socket to the app. Nothing binds a port and nothing is reachable from your network.
        </li>
        <li>
          <span class="text-[var(--color-fg)]">Scoped to one subscription.</span> Tools only see the
          subscription selected in the app. Anything else returns an error rather than reaching across.
        </li>
      </ul>
      <p class="mt-4 text-sm text-[var(--color-muted)] leading-relaxed">
        Message bodies you explicitly ask for do go to whichever AI provider your client uses — that's
        inherent to asking a model about them. viewbus itself sees none of it; see the
        <a href="/privacy/" class="text-[var(--color-accent)] hover:underline">privacy page</a>.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">Common questions</h2>
      <Faq items={faqs} class="mt-5" />
    </section>

    <div class="mt-14 flex flex-col gap-3 border-t border-[var(--color-border)] pt-8 sm:flex-row">
      <a
        href="/download/"
        class="inline-flex items-center justify-center rounded-full h-11 px-6 text-sm font-medium bg-[var(--color-fg)] text-[var(--color-bg)] transition-colors hover:bg-[color-mix(in_oklab,var(--color-fg)_88%,transparent)]"
      >Get viewbus</a>
      <a
        href="/developers/"
        class="inline-flex items-center justify-center rounded-full h-11 px-6 text-sm font-medium border border-[var(--color-border)] transition-colors hover:bg-[var(--color-hover)]"
      >Local HTTP API</a>
    </div>
  </article>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-mcp-tabs]");
      if (!root) return;
      const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll(".ct-panel"));

      const select = (id) => {
        tabs.forEach((t) => {
          const on = t.dataset.client === id;
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach((p) => { p.hidden = p.dataset.client !== id; });
        try { localStorage.setItem("viewbus-mcp-client", id); } catch {}
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab.dataset.client));
        tab.addEventListener("keydown", (e) => {
          const last = tabs.length - 1;
          let n = null;
          if (e.key === "ArrowRight") n = i === last ? 0 : i + 1;
          else if (e.key === "ArrowLeft") n = i === 0 ? last : i - 1;
          else if (e.key === "Home") n = 0;
          else if (e.key === "End") n = last;
          if (n === null) return;
          e.preventDefault();
          select(tabs[n].dataset.client);
          tabs[n].focus();
        });
      });

      let saved = null;
      try { saved = localStorage.getItem("viewbus-mcp-client"); } catch {}
      if (saved && tabs.some((t) => t.dataset.client === saved)) select(saved);

      const copyBtn = root.querySelector("[data-mcp-copy]");
      copyBtn?.addEventListener("click", async () => {
        const pre = panels.find((p) => !p.hidden)?.querySelector("pre");
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
          copyBtn.textContent = "Copied";
          copyBtn.classList.add("is-copied");
          setTimeout(() => { copyBtn.textContent = "Copy"; copyBtn.classList.remove("is-copied"); }, 1300);
        } catch {
          const sel = window.getSelection();
          const r = document.createRange();
          r.selectNodeContents(pre);
          sel.removeAllRanges();
          sel.addRange(r);
        }
      });
    })();
  </script>

  <style>
    .mcp-step {
      grid-column: 1;
      grid-row: 1;
      display: grid;
      place-items: center;
      width: 1.6rem;
      height: 1.6rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--color-accent);
      border: 1px solid color-mix(in oklab, var(--color-accent) 35%, transparent);
      border-radius: 9999px;
    }
  </style>
</Base>
