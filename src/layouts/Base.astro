---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, path, ogImage = "/og.png", noindex = false } = Astro.props;
const site = "https://viewbus.app";
// GitHub Pages serves directory-style URLs, so `/privacy` 301s to `/privacy/`.
// Canonicals and og:url must name the URL that actually answers 200.
const normalized = path === "/" ? "/" : `${path.replace(/\/+$/, "")}/`;
const canonical = new URL(normalized, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7eddc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="Håkon Lia" />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg?v=2" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="viewbus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="viewbus — Azure Service Bus desktop manager for Windows and macOS" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="viewbus — Azure Service Bus desktop manager for Windows and macOS" />

    <script is:inline>
      // Follow the OS unless the visitor has overridden it with the nav toggle.
      // Runs before first paint so there's no flash of the wrong theme.
      const pref = localStorage.getItem("viewbus-site-theme");
      const dark =
        pref === "dark" ||
        (pref !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
      if (!dark) {
        document.documentElement.classList.add("light");
      }

      // viewbus is a desktop app, so a phone can't install it. Decide before
      // first paint which copy to show. Capability-based, not viewport width:
      // a narrow window on a laptop still gets the real download buttons.
      if (
        navigator.userAgentData?.mobile === true ||
        (matchMedia("(pointer: coarse)").matches && matchMedia("(hover: none)").matches)
      ) {
        document.documentElement.classList.add("handheld");
      }
    </script>

    <noscript>
      <!-- .reveal starts at opacity:0 and is unhidden by an IntersectionObserver.
           Without JS that would hide half the page, so opt out entirely. -->
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-[var(--color-fg)] focus:text-[var(--color-bg)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lg"
    >
      Skip to content
    </a>
    <Nav path={normalized} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      }

      // Tease: clicking the fake-interactive chrome animates the download
      // buttons. Each button gets a random variant per click for a playful mix.
      const VARIANTS = [
        "wiggle", "pulse", "bounce", "wobble", "flash", "nudge", "shimmer",
        "glow-accent", "glow-info", "glow-success", "glow-danger",
        "squish", "heartbeat", "rainbow", "shake-v", "sweep",
      ];
      const pick = () => VARIANTS[Math.floor(Math.random() * VARIANTS.length)];
      const clear = (btn) => { for (const v of VARIANTS) btn.classList.remove(v); };
      const downloads = document.querySelectorAll("[data-download]");
      if (downloads.length > 0) {
        document.querySelectorAll("[data-tease]").forEach((el) => {
          el.addEventListener("click", () => {
            downloads.forEach((btn) => {
              clear(btn);
              void btn.offsetWidth;
              btn.classList.add(pick());
            });
          });
        });
        downloads.forEach((btn) => {
          btn.addEventListener("animationend", () => clear(btn));
        });
      }
    </script>
  </body>
</html>
